---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import SourceList from '@/components/SourceList.astro';
import { t } from '@/i18n/ui';
import { alternates, route, archivePath, type Lang } from '@/i18n/routes';
import { getPage, getPeople, getArchive } from '@/lib/content';
import pedroImg from '@/assets/video/pedro-linares-gallo.webp';
import pedroPintando from '@/assets/archivo/pedro-linares-pintando.jpg';
import mesaImg from '@/assets/video/felipe-y-su-padre-mesa.webp';
import calaverasImg from '@/assets/works/familia-calaveras-tamano-natural.webp';
import catrinaImg from '@/assets/works/catrina-emplumada-taller.jpg';
import ranaCut from '@/assets/works/alebrije-rana-recorte.png';
import famAlado from '@/assets/works/familia-alebrije-alado-rayado.jpg';
import famRana from '@/assets/works/familia-alebrije-rana-mariposa.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const es = lang === 'es';
const page = await getPage('legado', lang);
const { Content } = await render(page);
const historia = await getPage('historia', lang);
const { Content: Historia } = await render(historia);
const sections = page.data.sections ?? [];
const people = await getPeople();
const generations = Array.from(new Set(people.map((p) => p.data.generation))).sort();
const byId = Object.fromEntries(people.map((p) => [p.id, p]));
type Ev = { year: number; endYear?: number; subject: 'artist' | 'family' | 'tradition'; text: string; href?: string };
const fixed: Ev[] = [
  { year: 1906, subject: 'family', text: es ? 'Nace Pedro Linares López en la Ciudad de México (29 de junio).' : 'Pedro Linares López is born in Mexico City (June 29).' },
  { year: 1992, subject: 'family', text: es ? 'Muere Pedro Linares López en enero; sus hijos y nietos continúan el oficio.' : 'Pedro Linares López dies in January; his sons and grandsons continue the craft.' },
];
const timeline = [...fixed, ...(await getArchive()).map((e) => ({ year: e.data.year, endYear: e.data.endYear, subject: e.data.subject, text: e.data.title[lang], href: archivePath(e.id, lang) }))].sort((a, b) => a.year - b.year);
const allSources = people.flatMap((p) => p.data.sources).filter((s, i, arr) => arr.findIndex((x) => x.title === s.title) === i);
const genLabel = (g: number) => ({ 1: es ? 'Antepasados' : 'Ancestors', 2: 'Pedro Linares López', 3: es ? 'Los hijos' : 'The sons', 4: es ? 'Los nietos' : 'The grandchildren', 5: es ? 'Los bisnietos' : 'The great-grandchildren' } as Record<number, string>)[g] ?? ui.legacy.generation(g);
---
<Base lang={lang} title={page.data.title} description={page.data.seoDescription} alternates={alternates('legacy')}>
  <section class="portada" aria-labelledby="titulo-legado">
    <div class="contenedor">
      <div>
        <p class="antetitulo">{page.data.eyebrow}</p>
        <h1 id="titulo-legado">Legado <em>Linares</em></h1>
        <p class="lema">{es ? 'Un sueño en 1936. Cinco generaciones de cartoneros.' : 'A dream in 1936. Five generations of cartoneros.'}</p>
        <p class="entrada">{page.data.lead}</p>
        <div class="botones"><a class="boton boton-principal" href="#historia">{es ? 'Leer la historia' : 'Read the story'}</a><a class="boton boton-secundario" href="#arbol">{ui.legacy.tree}</a></div>
      </div>
      <figure class="portada-imagen portada-recorte" data-reveal="zoom" style="--i:1;--ancho-portada:38rem">
        <div class="portada-marco"><Image src={ranaCut} alt={es ? 'Alebrije de rana con pico de ave: cuerpo verde azulado con puntos, orejas rosadas, cabeza negra con manchas doradas, pico largo y patas amarillas.' : 'Frog alebrije with a bird’s beak: blue-green dotted body, pink ears, black head with gold spots, long beak and yellow feet.'} widths={[520, 900, 1300]} sizes="(max-width: 440px) 92vw, (max-width: 760px) 28rem, (max-width: 1160px) 46vw, 38rem" loading="eager" fetchpriority="high" /></div>
        <figcaption>{es ? 'Alebrije de rana con pico de ave, obra de Felipe Linares Vargas · título por confirmar' : 'Frog alebrije with a bird’s beak, by Felipe Linares Vargas · title to be confirmed'}</figcaption>
      </figure>
    </div>
  </section>

  <section class="seccion seccion-crema" aria-label={es ? 'Historia' : 'History'}>
    <div class="contenedor">
      <div class="dos-columnas">
        <div>
          {sections.slice(0, 3).map((s, i) => <><h2 style={i ? 'margin-top:2rem' : ''}>{s.heading}</h2><p>{s.text}</p></>)}
        </div>
        <div class="foto-lado">
          <figure class="foto" data-reveal><Image src={pedroImg} alt={es ? 'Fotograma de video antiguo: Pedro Linares López, de perfil, sostiene contra el pecho a Barbas, un gallo rojizo, en un interior en penumbra.' : 'Old video still: Pedro Linares López, in profile, holds Barbas, a reddish rooster, against his chest in a dim interior.'} widths={[480, 800, 1100]} sizes="(max-width: 820px) 100vw, 34rem" loading="lazy" /><figcaption>{es ? 'Pedro Linares López con el gallo Barbas · fotograma de video de archivo, fecha por confirmar.' : 'Pedro Linares López with the rooster Barbas · archival video still, date to be confirmed.'}</figcaption></figure>
          <ul class="datos">
            <li><strong>1936</strong>{es ? 'Pedro Linares López sueña con los alebrijes y empieza a modelarlos.' : 'Pedro Linares López dreams of the alebrijes and begins to model them.'}</li>
            <li><strong>1990</strong>{es ? 'Premio Nacional de Ciencias y Artes, Artes y Tradiciones Populares.' : 'National Prize for Arts and Sciences, Popular Arts and Traditions.'}</li>
            <li><strong>2019</strong>{es ? 'Los alebrijes, patrimonio cultural de la Ciudad de México.' : 'Alebrijes declared cultural heritage of Mexico City.'}</li>
          </ul>
        </div>
      </div>
      <div class="dos-columnas" style="margin-top:3rem">
        <figure class="foto" data-reveal style="max-width:26rem"><Image src={catrinaImg} alt={es ? 'Catrina de cartonería con tocado de plumas en el taller.' : 'Cartonería Catrina with a feathered headdress in the workshop.'} widths={[480, 800]} sizes="(max-width: 820px) 100vw, 26rem" loading="lazy" /><figcaption>{es ? 'Catrina con tocado de plumas, Felipe Linares Vargas.' : 'Catrina with feathered headdress, Felipe Linares Vargas.'}</figcaption></figure>
        <div>
          {sections.slice(3).map((s, i) => <><h2 style={i ? 'margin-top:2rem' : ''}>{s.heading}</h2><p>{s.text}</p></>)}
        </div>
      </div>
    </div>
  </section>

  <section class="seccion" id="historia" aria-labelledby="titulo-historia">
    <div class="contenedor dos-columnas">
      <div class="prosa historia"><p class="antetitulo">{historia.data.eyebrow}</p><h2 id="titulo-historia">{historia.data.title}</h2><Historia /></div>
      <div class="foto-lado">
        <figure class="foto" data-reveal><Image src={pedroPintando} alt={es ? 'Fotografía antigua: Pedro Linares López, con gorra y camisa amarilla, sentado ante un muro azul, pinta con un pincel un alebrije rojo con alas y cresta; latas de pintura en el suelo.' : 'Old photograph: Pedro Linares López, in a cap and yellow shirt, seated before a blue wall, painting a red winged, crested alebrije with a brush; paint cans on the floor.'} widths={[480, 551]} sizes="(max-width: 820px) 100vw, 34rem" loading="lazy" /><figcaption>{es ? 'Pedro Linares López pintando un alebrije · fotografía de archivo, autoría y fecha por confirmar.' : 'Pedro Linares López painting an alebrije · archival photograph, author and date to be confirmed.'}</figcaption></figure>
        <figure class="foto" data-reveal><Image src={mesaImg} alt={es ? 'Felipe Linares Vargas pinta un alebrije de plumas verdes y azules en la mesa del taller; frente a él, su padre Felipe Linares Mendoza, con gorra, observa la pieza.' : 'Felipe Linares Vargas paints a green-and-blue feathered alebrije at the workshop table; across from him, his father Felipe Linares Mendoza, in a cap, watches the piece.'} widths={[480, 800, 1200]} sizes="(max-width: 820px) 100vw, 34rem" loading="lazy" /><figcaption>{es ? 'Felipe Linares Vargas y su padre, Felipe Linares Mendoza, en la mesa del taller · fotograma de video.' : 'Felipe Linares Vargas and his father, Felipe Linares Mendoza, at the workshop table · video still.'}</figcaption></figure>
        <figure class="foto" data-reveal><Image src={calaverasImg} alt={es ? 'Felipe Linares Vargas y Felipe Linares Mendoza de pie ante cuatro calaveras de cartonería de tamaño natural vestidas de catrines y catrinas, sobre un lecho de pétalos de cempasúchil y frente a un telón pintado.' : 'Felipe Linares Vargas and Felipe Linares Mendoza standing before four life-size cartonería skeletons dressed as catrines and catrinas, on a bed of marigold petals in front of a painted backdrop.'} widths={[480, 800, 1024]} sizes="(max-width: 820px) 100vw, 34rem" loading="lazy" /><figcaption>{es ? 'Felipe Linares Vargas y Felipe Linares Mendoza con calaveras de tamaño natural · lugar, fecha y autoría de las piezas por confirmar.' : 'Felipe Linares Vargas and Felipe Linares Mendoza with life-size skeletons · place, date and makers of the pieces to be confirmed.'}</figcaption></figure>
        <figure class="foto" data-reveal><Image src={famAlado} alt={es ? 'Alebrije de cartonería con cuerpo rayado en verde y amarillo, alas abiertas en naranja y rojo con textura de piedras, y cara de felino con colmillos.' : 'Cartonería alebrije with a green-and-yellow striped body, open orange-and-red wings with a stone texture, and a fanged feline face.'} widths={[480, 800, 1080]} sizes="(max-width: 820px) 100vw, 34rem" loading="lazy" /><figcaption>{es ? 'Alebrije de la familia Linares · autoría y fotografía por confirmar.' : 'Alebrije by the Linares family · maker and photographer to be confirmed.'}</figcaption></figure>
        <figure class="foto" data-reveal><Image src={famRana} alt={es ? 'Alebrije con cuerpo de rana cubierto de escamas verdes, azules y naranjas, alas de mariposa en morado y azul, boca abierta con colmillos y lengua roja.' : 'Alebrije with a frog body covered in green, blue and orange scales, purple-and-blue butterfly wings, open mouth with fangs and a red tongue.'} widths={[480, 800, 1100]} sizes="(max-width: 820px) 100vw, 34rem" loading="lazy" /><figcaption>{es ? 'Alebrije de la familia Linares · autoría y fotografía por confirmar.' : 'Alebrije by the Linares family · maker and photographer to be confirmed.'}</figcaption></figure>
      </div>
    </div>
  </section>

  <section class="seccion seccion-oscura" id="arbol" aria-labelledby="tree-title">
    <div class="contenedor">
      <div class="encabezado-seccion" data-reveal><p class="antetitulo">{ui.legacy.tree}</p><h2 id="tree-title">{es ? 'Cinco generaciones' : 'Five generations'}</h2><p class="texto-suave">{ui.legacy.treeHint}</p></div>
      <div class="arbol" data-tree>
        <div>
          {generations.map((g) => (
            <div class="generacion">
              <p>{genLabel(g)}</p>
              <ul>{people.filter((p) => p.data.generation === g).map((p) => (
                <li><button type="button" class:list={['persona', { destacada: p.data.isFeaturedArtist }]} data-person={p.id} aria-expanded="false" aria-controls="tree-panel">
                  <strong>{p.data.shortName}</strong>
                  {p.data.born && <small>{p.data.born}{p.data.died ? `–${p.data.died}` : ''}</small>}
                  {p.data.parent && !p.data.parentConfirmed && <span class="aviso">{ui.legacy.relationUnconfirmed}</span>}
                </button></li>
              ))}</ul>
            </div>
          ))}
        </div>
        <div id="tree-panel" class="panel-persona" aria-live="polite">
          {people.map((p) => (
            <article data-card={p.id} hidden>
              <p class="antetitulo">{genLabel(p.data.generation)}{p.data.parent && byId[p.data.parent.id] && ` · ${es ? 'descendiente de' : 'descendant of'} ${byId[p.data.parent.id].data.shortName}`}</p>
              <h3>{p.data.name}</h3>
              <p class="texto-suave" style="font-size:0.95rem">{p.data.role[lang]}{p.data.datesNote?.[lang] && ` · ${p.data.datesNote[lang]}`}</p>
              <p>{p.data.bio[lang]}</p>
              {p.data.isFeaturedArtist && <p><a href={route('artist', lang)}>{ui.cta.artist} →</a></p>}
              <SourceList lang={lang} sources={p.data.sources} headingLevel="h4" />
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="seccion" id="cronologia" aria-labelledby="tl-title">
    <div class="contenedor">
      <div class="encabezado-seccion" data-reveal><p class="antetitulo">{ui.legacy.timeline}</p><h2 id="tl-title">{es ? 'De 1906 a hoy' : 'From 1906 to today'}</h2></div>
      <ol class="cronologia">
        {timeline.map((e) => <li><span class="anio">{e.year}{e.endYear && <small style="font-size:0.8rem;color:var(--tinta-suave)">–{e.endYear}</small>}</span><div><span class:list={['etiqueta-tema', { artista: e.subject === 'artist', tradicion: e.subject === 'tradition' }]}>{ui.archive.subjects[e.subject]}</span><p>{e.href ? <a href={e.href}>{e.text}</a> : e.text}</p></div></li>)}
      </ol>
      <div class="botones"><a class="boton boton-secundario" href={route('archive', lang)}>{ui.nav.archive}</a></div>
    </div>
  </section>

  <section class="seccion seccion-crema">
    <div class="contenedor dos-columnas">
      <div class="prosa"><Content /></div>
      <ul class="datos">
        <li><strong>{es ? 'Material' : 'Material'}</strong>{es ? 'Papel, cartón y engrudo sobre una estructura ligera' : 'Paper, cardboard and paste over a light armature'}</li>
        <li><strong>{es ? 'Forma' : 'Form'}</strong>{es ? 'Modelado a mano; pieza hueca y ligera' : 'Modeled by hand; hollow, light piece'}</li>
        <li><strong>{es ? 'Pintura' : 'Paint'}</strong>{es ? 'A pincel: manchas, escamas, nervaduras y puntos' : 'By brush: spots, scales, veins and dots'}</li>
        <li><strong>{es ? 'Origen' : 'Origin'}</strong>{es ? 'Pedro Linares López, Ciudad de México, 1936' : 'Pedro Linares López, Mexico City, 1936'}</li>
        <li><strong>{es ? 'Patrimonio' : 'Heritage'}</strong>{es ? 'Patrimonio cultural de la Ciudad de México desde 2019' : 'Cultural heritage of Mexico City since 2019'}</li>
      </ul>
    </div>
  </section>

  <section class="seccion"><div class="contenedor"><SourceList lang={lang} sources={allSources} heading={ui.archive.sources} headingLevel="h2" /></div></section>
</Base>

<script>
  function initTree() {
    const tree = document.querySelector<HTMLElement>('[data-tree]');
    if (!tree || tree.dataset.ready) return;
    tree.dataset.ready = '1';
    const nodes = Array.from(tree.querySelectorAll<HTMLButtonElement>('[data-person]'));
    const cards = Array.from(tree.querySelectorAll<HTMLElement>('[data-card]'));
    const panel = tree.querySelector<HTMLElement>('#tree-panel')!;
    const select = (id: string, scroll = false) => {
      nodes.forEach((n) => { const on = n.dataset.person === id; n.setAttribute('aria-expanded', String(on)); n.classList.toggle('activa', on); });
      cards.forEach((c) => { c.hidden = c.dataset.card !== id; });
      if (scroll && window.matchMedia('(max-width: 900px)').matches) panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };
    nodes.forEach((n) => n.addEventListener('click', () => select(n.dataset.person!, true)));
    const featured = nodes.find((n) => n.classList.contains('destacada')) ?? nodes[0];
    if (featured) select(featured.dataset.person!);
  }
  initTree();
  document.addEventListener('astro:page-load', initTree);
</script>
<style>
  .prosa :global(h2) { font-size: clamp(1.5rem, 3vw, 2rem); }
  .persona.destacada { border-color: var(--cempasuchil); }
</style>

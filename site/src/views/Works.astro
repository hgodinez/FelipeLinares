---
import Base from '@/layouts/Base.astro';
import ArtworkCard from '@/components/ArtworkCard.astro';
import { t } from '@/i18n/ui';
import { alternates, route, type Lang } from '@/i18n/routes';
import { getWorks } from '@/lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const works = await getWorks();
const used = Array.from(new Set(works.flatMap((w) => w.data.categories)));
const categoryOrder = ['alebrijes', 'calaveras', 'judas', 'mascaras', 'colecciones', 'encargos'] as const;
const categories = categoryOrder.filter((c) => used.includes(c));
---
<Base lang={lang} title={ui.nav.works} description={ui.works.intro} alternates={alternates('works')}>
  <section class="section works-head">
    <div class="container">
      <p class="eyebrow eyebrow--accent reveal">{ui.works.eyebrow}</p>
      <h1 class="reveal" style="--delay:80ms">{ui.works.title}</h1>
      <p class="lead mt-l reveal" style="--delay:160ms">{ui.works.intro}</p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="gallery-title">
    <div class="container">
      <h2 id="gallery-title" class="visually-hidden">{ui.works.gallery}</h2>
      <form class="filters" data-filters role="search" aria-label={ui.works.filterLabel}>
        <div class="filters__cats" role="group" aria-label={ui.works.filterLabel}>
          <button type="button" class="chip" data-cat="" aria-pressed="true">{ui.works.all}</button>
          {categories.map((c) => <button type="button" class="chip" data-cat={c} aria-pressed="false">{ui.works.categories[c]}</button>)}
        </div>
        <div class="filters__search">
          <label for="work-search" class="visually-hidden">{ui.works.search}</label>
          <input id="work-search" type="search" name="q" placeholder={ui.works.searchPlaceholder} autocomplete="off" data-search />
        </div>
        <p class="filters__count small muted" data-count aria-live="polite">{ui.works.count(works.length)}</p>
      </form>

      <div class="works-grid" data-grid>
        {works.map((w, i) => <ArtworkCard work={w} lang={lang} size={i % 5 === 0 && w.data.images.length > 0 ? 'large' : 'medium'} index={i} eager={i < 2} />)}
      </div>
      <p class="works-empty notice" data-empty hidden>{ui.works.empty} <button type="button" class="works-empty__reset" data-reset>{ui.works.reset}</button></p>
      <p class="small muted mt-l"><span style="color:var(--accent-ink)">*</span> {ui.works.provisional}.</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container--narrow container text-center">
      <h2 class="reveal">{lang === 'es' ? '¿Te interesa una obra o un encargo?' : 'Interested in a work or a commission?'}</h2>
      <a class="btn btn--solid mt-l reveal" style="--delay:100ms" href={route('contact', lang)}>{ui.cta.contact} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<script>
  import { initReveal } from '@/lib/reveal';
  function initFilters() {
    const form = document.querySelector<HTMLFormElement>('[data-filters]');
    const grid = document.querySelector<HTMLElement>('[data-grid]');
    if (!form || !grid || form.dataset.ready) return;
    form.dataset.ready = '1';
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.work-card'));
    const chips = Array.from(form.querySelectorAll<HTMLButtonElement>('[data-cat]'));
    const search = form.querySelector<HTMLInputElement>('[data-search]')!;
    const count = form.querySelector<HTMLElement>('[data-count]')!;
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    const reset = document.querySelector<HTMLButtonElement>('[data-reset]')!;
    const countTemplate = count.textContent || '';
    const num = cards.length;
    let cat = new URLSearchParams(location.search).get('categoria') || new URLSearchParams(location.search).get('category') || '';
    const label = (n: number) => countTemplate.replace(String(num), String(n)).replace(/^1 (\w+)s$/, '1 $1');

    const apply = () => {
      const q = search.value.trim().toLowerCase();
      let shown = 0;
      for (const c of cards) {
        const okCat = !cat || (c.dataset.categories || '').split(' ').includes(cat);
        const okQ = !q || (c.dataset.title || '').includes(q);
        const show = okCat && okQ;
        c.hidden = !show;
        if (show) { shown++; c.classList.add('is-visible'); }
      }
      count.textContent = label(shown);
      empty.hidden = shown > 0;
      chips.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.cat || '') === cat)));
      const url = new URL(location.href);
      if (cat) url.searchParams.set(document.documentElement.lang.startsWith('es') ? 'categoria' : 'category', cat); else { url.searchParams.delete('categoria'); url.searchParams.delete('category'); }
      history.replaceState(null, '', url);
    };
    chips.forEach((b) => b.addEventListener('click', () => { cat = b.dataset.cat || ''; apply(); }));
    search.addEventListener('input', apply);
    form.addEventListener('submit', (e) => e.preventDefault());
    reset.addEventListener('click', () => { cat = ''; search.value = ''; apply(); });
    apply();
    initReveal();
  }
  initFilters();
  document.addEventListener('astro:page-load', initFilters);
</script>

<style>
  .works-head { padding-bottom: var(--space-l); }
  .works-head h1 { font-size: var(--step-5); }
  .filters { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-s) var(--space-m); padding-block: var(--space-s); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); margin-bottom: var(--space-xl); }
  .filters__cats { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip { min-height: 44px; padding: 0 1em; border: 1px solid var(--line-strong); border-radius: 999px; font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; transition: background-color 200ms, color 200ms; }
  .chip:hover { border-color: var(--fg); }
  .chip[aria-pressed='true'] { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .filters__search { margin-left: auto; min-width: min(100%, 260px); }
  .filters__search input { width: 100%; min-height: 44px; font: inherit; font-size: var(--step--1); background: transparent; border: 0; border-bottom: 1px solid var(--line-strong); padding: 0.4em 0; color: inherit; border-radius: 0; }
  .filters__search input:focus-visible { outline: none; border-bottom-color: var(--turquoise); box-shadow: 0 1px 0 var(--turquoise); }
  .filters__count { margin: 0; flex-basis: 100%; }
  @media (min-width: 900px) { .filters__count { flex-basis: auto; } }
  .works-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--space-xl) var(--gutter); align-items: start; }
  .works-grid > :global(.work-card--large) { grid-column: span 7; }
  .works-grid > :global(.work-card--medium) { grid-column: span 5; }
  .works-grid > :global(.work-card--medium:nth-child(5n + 3)) { grid-column: span 4; }
  .works-grid > :global(.work-card--medium:nth-child(5n + 4)) { grid-column: span 4; margin-top: var(--space-xl); }
  .works-grid > :global(.work-card--medium:nth-child(5n)) { grid-column: span 4; }
  .works-grid > :global(.work-card--large:nth-child(5n + 1):not(:first-child)) { grid-column: 3 / span 7; }
  .works-grid > :global(.work-card--medium:nth-child(5n + 2)) { margin-top: var(--space-2xl); }
  @media (max-width: 900px) {
    .works-grid > :global(.work-card) { grid-column: span 6 !important; margin-top: 0 !important; }
    .works-grid > :global(.work-card--large) { grid-column: span 12 !important; }
  }
  @media (max-width: 540px) { .works-grid > :global(.work-card) { grid-column: span 12 !important; } }
  .works-empty { margin-top: var(--space-m); }
  .works-empty__reset { text-decoration: underline; margin-left: 0.5em; }
</style>

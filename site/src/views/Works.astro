---
import { Image, getImage } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Lightbox from '@/components/Lightbox.astro';
import { t } from '@/i18n/ui';
import { alternates, route, workPath, type Lang } from '@/i18n/routes';
import { getWorks } from '@/lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const es = lang === 'es';
const works = await getWorks();
const categoryOrder = ['alebrijes', 'calaveras', 'judas', 'mascaras', 'colecciones', 'encargos'] as const;
const salas = categoryOrder.map((c) => ({ id: c, works: works.filter((w) => w.data.categories.includes(c)) })).filter((s) => s.works.length);
const totalFotos = works.reduce((n, w) => n + w.data.images.length, 0);
const full = async (src: any) => (await getImage({ src, width: Math.min(1800, src.width), format: 'webp', quality: 82 })).src;
const salaTexto: Record<string, { es: string; en: string }> = {
  alebrijes: { es: 'Criaturas que reúnen varios animales en un solo cuerpo: felinos con alas, ranas con pico, colas que terminan en serpiente.', en: 'Creatures that gather several animals in one body: winged felines, frogs with beaks, tails that end in a serpent.' },
  calaveras: { es: 'Calaveras vestidas y animadas, una de las especialidades históricas de la familia Linares.', en: 'Dressed and animated skeletons, one of the Linares family’s historic specialties.' },
  colecciones: { es: 'Obras en colecciones y exposiciones institucionales, documentadas con fuentes públicas.', en: 'Works in institutional collections and exhibitions, documented with public sources.' },
  judas: { es: 'Figuras de temporada de la tradición cartonera.', en: 'Seasonal figures of the cartonería tradition.' },
  mascaras: { es: 'Máscaras de cartonería.', en: 'Cartonería masks.' },
  encargos: { es: 'Piezas realizadas por encargo y en colaboración.', en: 'Commissioned and collaborative pieces.' },
};
const enriched = await Promise.all(salas.map(async (s) => ({ ...s, items: await Promise.all(s.works.map(async (w) => ({ w, imgs: await Promise.all(w.data.images.map(async (im) => ({ ...im, full: await full(im.src) }))) }))) })));
---
<Base lang={lang} title={ui.nav.works} description={ui.works.intro} alternates={alternates('works')} bodyClass="pagina-oscura">
  <section class="galeria-entrada" aria-labelledby="titulo-galeria">
    <div class="contenedor">
      <p class="antetitulo">{ui.works.eyebrow}</p>
      <h1 id="titulo-galeria">{es ? 'Las obras de Felipe Linares Vargas' : 'The works of Felipe Linares Vargas'}</h1>
      <p>{es ? 'Alebrijes y calaveras modelados en papel y cartón, ordenados en salas como en un museo. Toca cualquier pieza para verla en grande y recorrer todas sus vistas; cada obra tiene además su propia página.' : 'Alebrijes and skeletons modeled in paper and cardboard, arranged in rooms like a museum. Tap any piece to see it large and browse all its views; each work also has its own page.'}</p>
      <ul class="galeria-cifras">
        <li><strong data-contar={works.length}>{works.length}</strong>{es ? 'obras' : 'works'}</li>
        <li><strong data-contar={totalFotos}>{totalFotos}</strong>{es ? 'fotografías' : 'photographs'}</li>
        <li><strong data-contar={salas.length}>{salas.length}</strong>{es ? 'salas' : 'rooms'}</li>
      </ul>
    </div>
  </section>

  <nav class="salas-nav" aria-label={es ? 'Salas' : 'Rooms'}>
    <div class="contenedor"><ul>
      {salas.map((s) => <li><a href={`#sala-${s.id}`}>{ui.works.categories[s.id]}</a></li>)}
    </ul></div>
  </nav>

  <div class="contenedor" style="padding-top:1.5rem">
    <form class="filtro-busqueda" role="search" data-filters>
      <label for="work-search" class="visually-hidden">{ui.works.search}</label>
      <input id="work-search" type="search" placeholder={ui.works.searchPlaceholder} autocomplete="off" data-search />
      <span class="texto-suave" data-count aria-live="polite">{ui.works.count(works.length)}</span>
    </form>
    <p class="estado estado-aviso" data-empty hidden>{ui.works.empty}</p>
  </div>

  {enriched.map((s, si) => (
    <section class="sala" id={`sala-${s.id}`} aria-labelledby={`titulo-sala-${s.id}`} data-sala>
      <div class="contenedor">
        <div class="sala-encabezado">
          <div><span class="sala-numero">{es ? 'Sala' : 'Room'} {si + 1}</span><h2 id={`titulo-sala-${s.id}`}>{ui.works.categories[s.id]}</h2></div>
          <p class="sala-texto">{salaTexto[s.id]?.[lang]}</p>
        </div>
        <ul class="muro" data-lb-group>
          {s.items.map(({ w, imgs }) => {
            const main = imgs.find((i) => i.kind !== 'workshop') ?? imgs[0];
            return (
              <li class="muro-pieza work-card" data-reveal data-title={w.data.title[lang].toLowerCase()}>
                <figure>
                  {main ? (
                    <>
                      <a href={workPath(w.id, lang)} data-lb-open data-full={main.full} data-alt={main.alt[lang]} data-title={w.data.title[lang]} data-caption={w.data.description[lang]}>
                        <Image src={main.src} alt={main.alt[lang]} widths={[360, 560, 800]} sizes="(max-width: 560px) 45vw, 15rem" loading="lazy" />
                        {imgs.length > 1 && <span class="muro-vistas">{imgs.length} {es ? 'vistas' : 'views'}</span>}
                      </a>
                      {imgs.slice(1).map((im) => <a class="visually-hidden" href={workPath(w.id, lang)} data-lb-open data-full={im.full} data-alt={im.alt[lang]} data-title={w.data.title[lang]} data-caption={[im.caption?.[lang], im.kind === 'workshop' ? ui.works.workshopNote : null].filter(Boolean).join(' · ')} tabindex="-1" aria-hidden="true">·</a>)}
                    </>
                  ) : (
                    <a href={workPath(w.id, lang)} class="marcador" style="aspect-ratio:4/5;border-radius:8px"><strong>{ui.works.placeholderTitle}</strong><span>{ui.works.placeholderText}</span></a>
                  )}
                  <figcaption><strong><a href={workPath(w.id, lang)}>{w.data.title[lang]}{w.data.titleStatus === 'provisional' && '*'}</a></strong><span>{[w.data.year, w.data.collection].filter(Boolean).join(' · ') || ui.works.categories[s.id]}</span></figcaption>
                </figure>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  ))}

  <section class="galeria-cierre">
    <div class="contenedor">
      <p>* {ui.works.provisional}. {es ? 'Las fichas, dimensiones y años se completarán con la confirmación del artista.' : 'Records, dimensions and years will be completed with the artist’s confirmation.'}</p>
      <div class="botones" style="justify-content:center"><a class="boton boton-principal" href={route('contact', lang)}>{ui.cta.contact}</a><a class="boton boton-secundario" href={route('home', lang)}>{ui.nav.home}</a></div>
    </div>
  </section>
  <Lightbox lang={lang} />
</Base>

<script>
  import { rememberOrigin, restoreOrigin } from '@/lib/motion';
  function initSearch() {
    const form = document.querySelector<HTMLFormElement>('[data-filters]');
    if (!form || form.dataset.ready) return;
    form.dataset.ready = '1';
    const input = form.querySelector<HTMLInputElement>('[data-search]')!;
    const count = form.querySelector<HTMLElement>('[data-count]')!;
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.work-card'));
    const salas = Array.from(document.querySelectorAll<HTMLElement>('[data-sala]'));
    const template = count.textContent || ''; const total = cards.length;
    const apply = () => {
      const q = input.value.trim().toLowerCase(); let shown = 0;
      cards.forEach((c) => { const ok = !q || (c.dataset.title || '').includes(q); c.hidden = !ok; if (ok) shown++; });
      salas.forEach((s) => { s.hidden = !s.querySelector('.work-card:not([hidden])'); });
      count.textContent = template.replace(String(total), String(shown)).replace(/^1 (\w+)s$/, '1 $1');
      empty.hidden = shown > 0;
    };
    input.addEventListener('input', apply);
    form.addEventListener('submit', (e) => e.preventDefault());
    document.querySelectorAll<HTMLAnchorElement>('a[href*="/obras/"], a[href*="/works/"]').forEach((a) => a.addEventListener('click', () => { const m = a.getAttribute('href')!.match(/\/(?:obras|works)\/([^/]+)\//); if (m) rememberOrigin(m[1]); }));
    restoreOrigin();
  }
  initSearch();
  document.addEventListener('astro:page-load', initSearch);
</script>

<style>
  .filtro-busqueda { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; align-items: center; }
  .filtro-busqueda input { font: inherit; color: var(--crema-texto); background: rgba(255, 245, 228, 0.06); border: 1.5px solid rgba(255, 250, 240, 0.25); border-radius: 999px; padding: 0.55rem 1rem; min-width: min(100%, 22rem); min-height: 44px; }
  .filtro-busqueda input::placeholder { color: var(--crema-suave); }
</style>

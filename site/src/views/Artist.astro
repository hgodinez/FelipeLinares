---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import SourceList from '@/components/SourceList.astro';
import Placeholder from '@/components/Placeholder.astro';
import ArtworkCard from '@/components/ArtworkCard.astro';
import Paper from '@/components/Paper.astro';
import { t } from '@/i18n/ui';
import { route, alternates, type Lang } from '@/i18n/routes';
import { getPage, getWorks, getPeople, getArchive } from '@/lib/content';
import detailImg from '@/assets/works/alebrije-tigre-cenital.jpg';
import workshopImg from '@/assets/works/alebrije-astado-perfil-taller.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const page = await getPage('maestro', lang);
const { Content } = await render(page);
const people = await getPeople();
const felipe = people.find((p) => p.data.isFeaturedArtist)!;
const archive = (await getArchive()).filter((a) => a.data.subject === 'artist');
const works = (await getWorks()).filter((w) => w.data.images.length > 0).slice(0, 3);
const milestones = [
  { year: '—', label: lang === 'es' ? 'Nacimiento y primeros años en la Ciudad de México' : 'Birth and early years in Mexico City', status: 'pending' as const },
  { year: '—', label: lang === 'es' ? 'Aprendizaje en el taller de su padre, Felipe Linares Mendoza' : 'Apprenticeship in the workshop of his father, Felipe Linares Mendoza', status: 'pending' as const },
  ...archive.sort((a, b) => a.data.year - b.data.year).map((a) => ({ year: String(a.data.year) + (a.data.endYear ? `–${a.data.endYear}` : ''), label: a.data.title[lang], status: 'verified' as const })),
];
const personLd = { '@context': 'https://schema.org', '@type': 'Person', name: felipe.data.name, description: felipe.data.bio[lang], url: new URL(route('artist', lang), Astro.site).toString(), jobTitle: lang === 'es' ? 'Cartonero' : 'Cartonería artist', address: { '@type': 'PostalAddress', addressLocality: 'Ciudad de México', addressCountry: 'MX' } };
---
<Base lang={lang} title={ui.nav.artist} description={page.data.seoDescription} alternates={alternates('artist')} jsonLd={personLd} topScene="lime">
  <section class="artist-hero scene-lime">
    <div class="container artist-hero__grid">
      <div class="artist-hero__text">
        <p class="eyebrow">{page.data.eyebrow}</p>
        <h1>{page.data.title}</h1>
        <p class="lead mt-m">{page.data.lead}</p>
        <p class="small mt-m artist-hero__role">{felipe.data.role[lang]}</p>
      </div>
      <div class="artist-hero__portrait">
        <div class="sheet"><Paper tone="light" cut="d" fold="tr" class="artist-hero__paper">
          <Placeholder lang={lang} ratio="4/5" title={lang === 'es' ? 'Retrato de Felipe' : 'Portrait of Felipe'} text={lang === 'es' ? 'Fotografía en el taller, con su autorización. Pendiente.' : 'Photograph in the workshop, with his permission. Pending.'} />
        </Paper></div>
      </div>
    </div>
  </section>

  <section class="scene-paper section">
    <div class="container grid">
      <div class="col-7 prose artist-body"><Content /></div>
      <aside class="col-5 artist-aside">
        <figure class="figure"><div class="sheet--soft reveal-mask"><Image src={detailImg} alt={lang === 'es' ? 'Alebrije de tigre alado visto desde arriba: alas negras abiertas y cola de serpiente.' : 'Winged tiger alebrije seen from above: open black wings and serpent tail.'} widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 40vw" loading="lazy" /></div><figcaption><span>{lang === 'es' ? 'Alebrije de tigre alado, vista cenital.' : 'Winged tiger alebrije, overhead view.'}</span></figcaption></figure>
        <figure class="figure mt-l"><div class="sheet--soft reveal-mask" style="--delay:120ms"><Image src={workshopImg} alt={lang === 'es' ? 'Alebrije de jaguar con astas, de perfil, en la mesa del taller.' : 'Antlered jaguar alebrije, in profile, on the workshop table.'} widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 40vw" loading="lazy" /></div><figcaption><span>{lang === 'es' ? 'Fotografía de taller.' : 'Workshop photograph.'}</span></figcaption></figure>
      </aside>
    </div>
  </section>

  <section class="scene-ink section" aria-labelledby="timeline-title">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">{ui.legacy.timeline}</p><h2 id="timeline-title">{lang === 'es' ? 'Hitos documentados' : 'Documented milestones'}</h2></div>
        <p class="small muted" style="max-width:40ch">{lang === 'es' ? 'Solo se incluyen fechas verificadas en fuentes públicas. Los hitos personales se añadirán con la confirmación del artista.' : 'Only dates verified in public sources are included. Personal milestones will be added with the artist’s confirmation.'}</p>
      </div>
      <ol class="milestones">
        {milestones.map((m) => (
          <li class:list={['milestone', { 'milestone--pending': m.status === 'pending' }]}>
            <span class="milestone__year">{m.year}</span>
            <span class="milestone__label">{m.label}{m.status === 'pending' && <span class="tag tag--accent">{ui.misc.toConfirm}</span>}</span>
          </li>
        ))}
      </ol>
      <div class="mt-l"><a class="link-arrow" href={route('archive', lang)}>{ui.nav.archive} <span class="arrow" aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="scene-paper section">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow eyebrow--accent">{ui.works.eyebrow}</p><h2>{lang === 'es' ? 'Obras seleccionadas' : 'Selected works'}</h2></div><a class="link-arrow" href={route('works', lang)}>{ui.cta.allWorks} <span class="arrow" aria-hidden="true">→</span></a></div>
      <div class="works-row">{works.map((w) => <ArtworkCard work={w} lang={lang} size="small" />)}</div>
      <div class="mt-xl"><SourceList lang={lang} sources={felipe.data.sources} /></div>
    </div>
  </section>
</Base>

<style>
  .artist-hero { padding-block: var(--space-xl); }
  .artist-hero__grid { display: grid; grid-template-columns: 7fr 5fr; gap: var(--space-l) var(--gutter); align-items: end; }
  .artist-hero h1 { font-size: var(--type-hero); }
  .artist-hero__role { font-weight: 700; }
  .artist-hero__paper { padding: 12px; }
  .artist-aside { display: grid; align-content: start; }
  .artist-aside :global(img) { width: 100%; height: auto; }
  .milestones { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .milestone { display: grid; grid-template-columns: 9ch 1fr; gap: var(--space-m); padding: var(--space-s) 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .milestone__year { font-family: var(--font-display); font-weight: 600; font-size: var(--type-h4); }
  .milestone__label { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; }
  .milestone--pending .milestone__label { color: var(--fg-muted); }
  .works-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gutter); }
  @media (max-width: 900px) { .artist-hero__grid { grid-template-columns: 1fr; } .artist-hero__portrait { max-width: 360px; } }
  @media (max-width: 760px) { .works-row { grid-template-columns: 1fr 1fr; } .milestone { grid-template-columns: 1fr; gap: 0.2rem; } }
  @media (max-width: 480px) { .works-row { grid-template-columns: 1fr; } }
</style>

---
import { Image } from 'astro:assets';
import { getEntries } from 'astro:content';
import Base from '@/layouts/Base.astro';
import SourceList from '@/components/SourceList.astro';
import { t } from '@/i18n/ui';
import { alternates, route, archivePath, workPath, type Lang } from '@/i18n/routes';
import { coverOf, type ArchiveItem } from '@/lib/content';

interface Props { lang: Lang; item: ArchiveItem }
const { lang, item } = Astro.props;
const ui = t(lang);
const d = item.data;
const people = await getEntries(d.people);
const artworks = await getEntries(d.artworks);
const title = d.title[lang];
const ld = { '@context': 'https://schema.org', '@type': d.type === 'exhibition' ? 'ExhibitionEvent' : 'CreativeWork', name: title, description: d.summary[lang], ...(d.type === 'exhibition' ? { startDate: String(d.year), ...(d.endYear ? { endDate: String(d.endYear) } : {}), location: { '@type': 'Place', name: [d.institution, d.city].filter(Boolean).join(', ') } } : { datePublished: String(d.year) }), url: new URL(archivePath(item.id, lang), Astro.site).toString() };
---
<Base lang={lang} title={title} description={d.summary[lang]} alternates={alternates('archive', item.id)} jsonLd={ld}>
  <section class="seccion">
    <div class="contenedor">
      <p style="margin-bottom:1.5rem;font-weight:600"><a href={route('archive', lang)} style="text-decoration:none">← {ui.nav.archive}</a></p>
      <div class="dos-columnas">
        <div>
          <p><span class:list={['etiqueta-tema', { artista: d.subject === 'artist', tradicion: d.subject === 'tradition' }]}>{ui.archive.subjects[d.subject]}</span><span class="etiqueta-tema">{ui.archive.types[d.type]}</span></p>
          <h1 style="font-size:clamp(1.9rem,4.5vw,3rem)">{title}</h1>
          <p class="lema" style="font-family:var(--fuente-titulos);font-style:italic;color:var(--bermellon-oscuro);font-size:1.25rem">{d.dateLabel?.[lang] ?? (d.endYear ? `${d.year}–${d.endYear}` : d.year)}{d.institution && ` · ${d.institution}`}{d.city && ` · ${d.city}`}</p>
          <p style="font-size:1.15rem">{d.summary[lang]}</p>
          {d.body?.[lang] && <p class="texto-suave">{d.body[lang]}</p>}
          {d.image && <figure class="foto" data-reveal style="margin-top:1.5rem"><Image src={d.image} alt={d.imageAlt?.[lang] ?? ''} widths={[640, 1024]} sizes="(max-width: 900px) 100vw, 40rem" /></figure>}
        </div>
        <div class="foto-lado">
          {people.length > 0 && <ul class="datos"><li><strong>{ui.archive.people}</strong>{people.map((p) => <span style="display:block"><a href={p.data.isFeaturedArtist ? route('artist', lang) : `${route('legacy', lang)}#arbol`}>{p.data.name}</a> · <span class="texto-suave">{p.data.role[lang]}</span></span>)}</li></ul>}
          <div class="datos" style="display:block"><div style="background:var(--blanco);border:1px solid var(--borde);border-radius:var(--radio);padding:1.1rem 1.25rem"><SourceList lang={lang} sources={d.sources} heading={ui.archive.sources} headingLevel="h2" /></div></div>
        </div>
      </div>
    </div>
  </section>
  {artworks.length > 0 && (
    <section class="seccion seccion-oscura">
      <div class="contenedor">
        <h2>{ui.archive.artworks}</h2>
        <ul class="piezas">{artworks.map((w) => { const c = coverOf(w); return (
          <li class="pieza" data-reveal data-tilt="7">{c ? <a class="pieza-imagen" href={workPath(w.id, lang)}><Image src={c.src} alt={c.alt[lang]} widths={[360, 600]} sizes="(max-width: 560px) 45vw, 20rem" loading="lazy" /></a> : <a class="marcador" href={workPath(w.id, lang)} style="aspect-ratio:3/4;border-radius:10px"><strong>{w.data.title[lang]}</strong><span>{ui.works.placeholderText}</span></a>}<p><span><strong><a href={workPath(w.id, lang)}>{w.data.title[lang]}</a></strong><span class="pieza-nota">{w.data.collection ?? w.data.categories.map((x) => ui.works.categories[x]).join(' · ')}</span></span></p></li>
        ); })}</ul>
      </div>
    </section>
  )}
</Base>

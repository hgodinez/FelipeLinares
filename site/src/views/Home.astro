---
import { Image, getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Lightbox from '@/components/Lightbox.astro';
import { t } from '@/i18n/ui';
import { route, alternates, workPath, archivePath, type Lang } from '@/i18n/routes';
import { getPage, getPeople, getWorks, getArchive, coverOf } from '@/lib/content';
import site from '@/data/site.json';
import heroImg from '@/assets/works/alebrije-astado-repisa.jpg';
import manoImg from '@/assets/works/alebrije-astado-mano.jpg';
import tallerImg from '@/assets/works/alebrije-astado-frente-taller.jpg';
import tallerCenital from '@/assets/works/alebrije-astado-cenital-taller.jpg';
import tigreCenital from '@/assets/works/alebrije-tigre-cenital.jpg';
import mEscamas from '@/assets/macro/jaguar-escamas.jpg';
import mAlas from '@/assets/macro/jaguar-alas.jpg';
import mColmillos from '@/assets/macro/jaguar-colmillos.jpg';
import mRanaLomo from '@/assets/macro/rana-lomo.jpg';
import mRanaOjo from '@/assets/macro/rana-ojo.jpg';
import mTigreAlas from '@/assets/macro/tigre-alas.jpg';
import mSerpiente from '@/assets/macro/tigre-serpiente.jpg';
import mCalavera from '@/assets/macro/calavera-rostro.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const es = lang === 'es';
const page = await getPage('inicio', lang);
const S = page.data.sections ?? [];
const taller = await getPage('taller', lang);
const pasos = taller.data.sections ?? [];
const people = await getPeople();
const byId = Object.fromEntries(people.map((p) => [p.id, p]));
const works = (await getWorks()).filter((w) => w.data.images.length > 0);
const archive = await getArchive();
const tz = await getEntry('artworks', 'tzompantli-2010');
const og = await getImage({ src: heroImg, width: 1200, format: 'jpg' });
const fullOf = async (src: any) => (await getImage({ src, width: Math.min(1600, src.width), format: 'webp', quality: 82 })).src;
const piezas = await Promise.all(works.map(async (w) => { const c = coverOf(w)!; return { w, cover: c, full: await fullOf(c.src) }; }));
const detalles = [
  { img: mEscamas, t: es ? 'Escamas y uñas' : 'Scales and nails', d: es ? 'Garras verdes cubiertas de escamas pintadas una por una; las uñas, de marfil.' : 'Green claws covered in scales painted one by one; ivory nails.' },
  { img: mAlas, t: es ? 'Nervaduras' : 'Wing veins', d: es ? 'Alas de murciélago en rojo con las nervaduras trazadas en blanco sobre la pintura seca.' : 'Red bat wings with veins traced in white over the dry paint.' },
  { img: mColmillos, t: es ? 'Colmillos y lengua' : 'Tusks and tongue', d: es ? 'Colmillos curvos modelados en papel y una lengua larga en bermellón.' : 'Curved tusks modeled in paper and a long vermilion tongue.' },
  { img: mRanaLomo, t: es ? 'Puntos sobre verde' : 'Dots on green', d: es ? 'El lomo de la rana: puntos de dos tamaños que dan textura a un volumen liso.' : 'The frog’s back: dots of two sizes giving texture to a smooth volume.' },
  { img: mRanaOjo, t: es ? 'Ojo y pico' : 'Eye and beak', d: es ? 'Cabeza de ave sobre cuerpo de rana; el cuello escamado en azul y oro.' : 'A bird’s head on a frog’s body; the neck scaled in blue and gold.' },
  { img: mTigreAlas, t: es ? 'Manchas de jaguar' : 'Jaguar spots', d: es ? 'Rosetas negras sobre naranja, pintadas a pincel a lo largo de todo el cuerpo.' : 'Black rosettes on orange, brush-painted along the whole body.' },
  { img: mSerpiente, t: es ? 'Cola de serpiente' : 'Serpent tail', d: es ? 'La cola del tigre termina en una cabeza de serpiente de ojos amarillos.' : 'The tiger’s tail ends in a yellow-eyed serpent head.' },
  { img: mCalavera, t: es ? 'Alas de monarca' : 'Monarch wings', d: es ? 'Una calavera con alas de mariposa monarca, pintadas en naranja, negro y violeta.' : 'A skull with monarch-butterfly wings, painted orange, black and violet.' },
];
const reconocimientos = [
  { etiqueta: 'Museo Nacional de Culturas Populares', titulo: es ? '«Tzompantli» (2010), en la colección' : '“Tzompantli” (2010), in the collection', texto: es ? 'Obra de Felipe Linares Vargas en cartón moldeado, modelado y policromado, 122 × 104 × 20 cm, con ficha pública en Google Arts & Culture.' : 'Work by Felipe Linares Vargas in molded, modeled and polychromed cardboard, 122 × 104 × 20 cm, with a public record on Google Arts & Culture.', links: [[es ? 'Ver la ficha de la obra' : 'View the object record', workPath('tzompantli-2010', lang)], [es ? 'Ver en Google Arts & Culture' : 'See on Google Arts & Culture', 'https://artsandculture.google.com/asset/tzompantli-felipe-linares-vargas/6QF5pI323yT3ww']] },
  { etiqueta: 'Museum of International Folk Art · Nuevo México', titulo: es ? '«Alebrijes: A Linares Family Tradition»' : '“Alebrijes: A Linares Family Tradition”', texto: es ? 'Exposición itinerante con obras de tres generaciones de la familia, inaugurada en 2026 en el Consulado de México en Albuquerque. Incluye un alebrije de gallo de Felipe.' : 'Traveling exhibition with works by three generations of the family, opened in 2026 at the Consulate of Mexico in Albuquerque. It includes a rooster alebrije by Felipe.', links: [[es ? 'Ver el registro' : 'View the record', archivePath('2026-moifa-alebrijes-linares-family-tradition', lang)]] },
  { etiqueta: es ? 'La herencia' : 'The heritage', titulo: 'Pedro Linares López', texto: es ? 'Su abuelo creó los alebrijes en 1936 y recibió el Premio Nacional de Ciencias y Artes en 1990. Su obra está en museos de México y del extranjero.' : 'His grandfather created the alebrijes in 1936 and received the National Prize for Arts and Sciences in 1990. His work is held by museums in Mexico and abroad.', links: [[es ? 'Conocer el legado familiar' : 'Discover the family legacy', route('legacy', lang)]] },
];
const prensa = archive.filter((a) => a.data.type === 'press' || a.data.type === 'publication');
const personLd = { '@context': 'https://schema.org', '@type': 'Person', name: 'Felipe Linares Vargas', jobTitle: es ? 'Cartonero' : 'Cartonería artist', description: site.defaultDescription[lang], url: new URL(route('home', lang), Astro.site).toString(), address: { '@type': 'PostalAddress', addressLocality: 'Ciudad de México', addressCountry: 'MX' }, knowsAbout: ['Cartonería', 'Alebrijes', 'Arte popular mexicano'] };
---
<Base lang={lang} title={site.artistName} description={page.data.seoDescription} alternates={alternates('home')} ogImage={og.src} jsonLd={personLd}>

  <!-- PORTADA -->
  <section class="portada" id="inicio" aria-labelledby="titulo-portada">
    <div class="contenedor">
      <div>
        <p class="antetitulo">{page.data.eyebrow}</p>
        <h1 id="titulo-portada">Felipe Linares <em>Vargas</em></h1>
        <p class="lema">{site.heroStatement[lang]}</p>
        <p class="entrada">{page.data.lead}</p>
        <div class="botones">
          <a class="boton boton-principal" href="#maestro">{es ? 'Conoce su historia' : 'Discover his story'}</a>
          <a class="boton boton-secundario" href="#obras">{ui.cta.works}</a>
        </div>
      </div>
      <figure class="portada-imagen">
        <div class="portada-marco"><Image src={heroImg} alt={es ? 'Alebrije de cartonería con cabeza de felino negro, astas de venado, alas rojas de murciélago y garras verdes, sobre una repisa.' : 'Cartonería alebrije with a black feline head, deer antlers, red bat wings and green claws, on a shelf.'} widths={[480, 960, 1200]} sizes="(max-width: 440px) 88vw, (max-width: 760px) 24rem, (max-width: 1160px) 42vw, 30rem" loading="eager" fetchpriority="high" style="object-position: 55% 45%" /></div>
        <figcaption>{es ? 'Alebrije de jaguar con astas de venado · título descriptivo, por confirmar' : 'Jaguar alebrije with deer antlers · descriptive title, pending confirmation'}</figcaption>
      </figure>
    </div>
  </section>

  <!-- EL MAESTRO -->
  <section class="seccion seccion-crema" id="maestro" aria-labelledby="titulo-maestro">
    <div class="contenedor dos-columnas">
      <div>
        <p class="antetitulo">{ui.nav.artist}</p>
        <h2 id="titulo-maestro">{S[0].heading}</h2>
        <p>{S[0].text}</p>
        <h3 class="subtitulo-seccion" style="margin-top:1.5rem">{S[1].heading}</h3>
        <p>{S[1].text}</p>
        <ul class="linaje">
          <li><span>{es ? 'Abuelo' : 'Grandfather'}</span><strong><a href={`${route('legacy', lang)}#arbol`}>Pedro Linares López</a></strong></li>
          <li><span>{es ? 'Padre' : 'Father'}</span><strong><a href={`${route('legacy', lang)}#arbol`}>Felipe Linares Mendoza</a></strong></li>
          <li class="actual"><span>{es ? 'Cartonero' : 'Cartonero'}</span><strong>Felipe Linares Vargas</strong></li>
        </ul>
        <div class="botones"><a class="boton boton-secundario" href={route('artist', lang)}>{ui.cta.artist}</a></div>
      </div>
      <div class="foto-lado">
        <figure class="cita-grande" style="margin-bottom:1.5rem"><blockquote><p style="font-size:clamp(1.5rem,3vw,2.1rem)">{es ? '«Me atrajo más estar aquí con mi papá porque aquí expresaba mi creatividad».' : '“I was more drawn to being here with my dad, because here I expressed my creativity.”'}</p></blockquote><figcaption>Felipe Linares Vargas</figcaption></figure>
        <figure class="foto"><Image src={manoImg} alt={es ? 'Una mano sostiene el alebrije de jaguar con astas: cabeza negra, ojos ámbar y lengua roja.' : 'A hand holds the antlered jaguar alebrije: black head, amber eyes and red tongue.'} widths={[480, 800, 1100]} sizes="(max-width: 820px) 100vw, 40rem" loading="lazy" style="aspect-ratio:4/3;object-fit:cover;object-position:50% 40%" /><figcaption>{es ? 'La escala de una pieza en la mano.' : 'The scale of a piece in the hand.'}</figcaption></figure>
        <ul class="datos">
          <li><strong>{es ? 'Ciudad' : 'City'}</strong>{es ? 'Merced Balbuena, Ciudad de México' : 'Merced Balbuena, Mexico City'}</li>
          <li><strong>{es ? 'Técnica' : 'Technique'}</strong>{es ? 'Cartonería: papel y cartón modelados y pintados a mano' : 'Cartonería: paper and cardboard modeled and painted by hand'}</li>
          <li><strong>{es ? 'Piezas' : 'Pieces'}</strong>{es ? 'Alebrijes, calaveras, judas y figuras de temporada' : 'Alebrijes, skeletons, Judas figures and seasonal pieces'}</li>
          <li><strong>{es ? 'Familia' : 'Family'}</strong>{es ? 'Nieto de Pedro Linares López, creador de los alebrijes' : 'Grandson of Pedro Linares López, creator of the alebrijes'}</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- LOS ALEBRIJES -->
  <section class="seccion seccion-oscura" id="alebrijes" aria-labelledby="titulo-alebrijes">
    <div class="contenedor">
      <div class="dos-columnas">
        <div>
          <p class="antetitulo">{es ? 'Tradición de la Ciudad de México' : 'A Mexico City tradition'}</p>
          <h2 id="titulo-alebrijes">{S[2].heading}</h2>
          <p class="texto-suave" style="font-size:1.15rem">{S[2].text}</p>
          <h3 class="subtitulo-seccion">{S[3].heading}</h3>
          <p class="texto-suave">{S[3].text}</p>
        </div>
        <figure class="foto"><Image src={tigreCenital} alt={es ? 'Alebrije de tigre alado visto desde arriba: alas negras abiertas, cuerpo moteado y cola de serpiente.' : 'Winged tiger alebrije seen from above: open black wings, spotted body and serpent tail.'} widths={[480, 800, 1100]} sizes="(max-width: 820px) 100vw, 36rem" loading="lazy" style="aspect-ratio:4/5;object-fit:cover" /><figcaption>{es ? 'Alebrije de tigre alado con cola de serpiente, vista cenital.' : 'Winged tiger alebrije with serpent tail, overhead view.'}</figcaption></figure>
      </div>
      <div class="nota-oscura">
        <p class="nota-titulo">{es ? 'Los alebrijes son de cartonería' : 'Alebrijes are cartonería'}</p>
        <p>{es ? 'El nombre, el concepto y la técnica —el sueño, el papel y el cartón— pertenecen a la Ciudad de México y a la familia Linares. Desde 2019 son patrimonio cultural de la ciudad.' : 'The name, the concept and the technique (the dream, the paper and the cardboard) belong to Mexico City and to the Linares family. Since 2019 they are cultural heritage of the city.'}</p>
      </div>
    </div>
  </section>

  <!-- LA TÉCNICA -->
  <section class="seccion" id="tecnica" aria-labelledby="titulo-tecnica">
    <div class="contenedor">
      <div class="encabezado-seccion">
        <p class="antetitulo">{es ? 'La técnica' : 'The technique'}</p>
        <h2 id="titulo-tecnica">{S[4].heading}</h2>
        <p class="texto-suave">{S[4].text}</p>
      </div>
      <h3 class="subtitulo-seccion" style="margin-top:0">{es ? 'Del papel a la criatura' : 'From paper to creature'}</h3>
      <p>{es ? 'Así se construye una pieza de cartonería, según las fuentes consultadas y las fotografías de taller de este sitio. Los detalles propios del método de Felipe se incorporarán con su confirmación.' : 'This is how a cartonería piece is built, according to the sources consulted and the workshop photographs on this site. The specifics of Felipe’s own method will be added with his confirmation.'}</p>
      <ol class="pasos">
        {pasos.map((p) => <li><h3>{p.heading}</h3><p>{p.text}</p>{p.note && <p class="pendiente">{p.note}</p>}</li>)}
      </ol>
      <div class="nota"><p><strong>{es ? '¿Cuánto tarda una pieza?' : 'How long does a piece take?'}</strong> {es ? 'Cada capa de papel se seca antes de la siguiente, a veces durante días. Las piezas grandes requieren semanas de secado y pintura.' : 'Each layer of paper dries before the next, sometimes for days. Large pieces need weeks of drying and painting.'}</p></div>
      <h3 class="subtitulo-seccion">{es ? 'En detalle' : 'In detail'}</h3>
      <p>{es ? 'Acercamientos a la pintura y el modelado de las piezas.' : 'Close-ups of the painting and modeling of the pieces.'}</p>
      <ul class="detalles">
        {detalles.map((d) => <li><figure><Image src={d.img} alt={d.d} widths={[360, 600]} sizes="(max-width: 1000px) 45vw, 17rem" loading="lazy" /><figcaption><strong>{d.t}</strong>{d.d}</figcaption></figure></li>)}
      </ul>
      <div class="botones"><a class="boton boton-secundario" href={route('workshop', lang)}>{ui.cta.process}</a></div>
    </div>
  </section>

  <!-- LAS OBRAS -->
  <section class="seccion seccion-oscura" id="obras" aria-labelledby="titulo-obras">
    <div class="contenedor">
      <div class="encabezado-seccion">
        <p class="antetitulo">{es ? 'Su obra' : 'His work'}</p>
        <h2 id="titulo-obras">{S[5].heading}</h2>
        <p class="texto-suave">{S[5].text}</p>
      </div>
      <ul class="piezas" data-lb-group>
        {piezas.map(({ w, cover, full }, i) => (
          <li class="pieza">
            <a class="pieza-imagen" href={workPath(w.id, lang)} data-lb-open data-full={full} data-alt={cover.alt[lang]} data-title={w.data.title[lang]} data-caption={w.data.description[lang].slice(0, 180) + '…'}>
              <Image src={cover.src} alt={cover.alt[lang]} widths={[360, 600, 900]} sizes="(max-width: 560px) 45vw, (max-width: 1160px) 30vw, 22rem" loading="lazy" />
            </a>
            <p><span class="pieza-numero" aria-hidden="true">{i + 1}</span><span><strong><a href={workPath(w.id, lang)}>{w.data.title[lang]}{w.data.titleStatus === 'provisional' && '*'}</a></strong><span class="pieza-nota">{w.data.categories.map((c) => ui.works.categories[c]).join(' · ')}</span></span></p>
          </li>
        ))}
      </ul>
      <p class="texto-suave" style="margin-top:1.25rem;font-size:0.92rem">* {ui.works.provisional}.</p>
      <div class="botones"><a class="boton boton-principal" href={route('works', lang)}>{ui.cta.allWorks}</a></div>
    </div>
  </section>

  <!-- RECONOCIMIENTOS -->
  <section class="seccion seccion-crema" id="reconocimientos" aria-labelledby="titulo-reconocimientos">
    <div class="contenedor">
      <div class="encabezado-seccion">
        <p class="antetitulo">{es ? 'Reconocimientos' : 'Recognition'}</p>
        <h2 id="titulo-reconocimientos">{S[6].heading}</h2>
        <p class="texto-suave">{S[6].text}</p>
      </div>
      <div class="tarjetas">
        {reconocimientos.map((r) => <article class="tarjeta"><p class="etiqueta">{r.etiqueta}</p><h3>{r.titulo}</h3><p>{r.texto}</p>{r.links.map(([t, h]) => <a href={h} target={h.startsWith('http') ? '_blank' : undefined} rel={h.startsWith('http') ? 'noopener noreferrer' : undefined}>{t}</a>)}</article>)}
      </div>
    </div>
  </section>

  <!-- LEGADO -->
  <section class="seccion seccion-oscura" id="legado" aria-labelledby="titulo-legado">
    <div class="contenedor" style="max-width:46rem">
      <p class="antetitulo">{ui.nav.legacy}</p>
      <h2 id="titulo-legado">{es ? 'Una historia que continúa' : 'A story that continues'}</h2>
      <p class="texto-suave">{es ? 'El trabajo de la familia Linares ha llegado a museos de México, Estados Unidos y Europa, pero cada pieza nace en la Ciudad de México, en talleres que son al mismo tiempo casas. De don Pedro a sus hijos Enrique, Felipe y Miguel; de ellos a Felipe, Leonardo, David y Ricardo; y ya a una generación más.' : 'The Linares family’s work has reached museums in Mexico, the United States and Europe, but every piece is born in Mexico City, in workshops that are also homes. From don Pedro to his sons Enrique, Felipe and Miguel; from them to Felipe, Leonardo, David and Ricardo; and now to one more generation.'}</p>
      <figure class="cita-grande" style="margin-top:2rem"><span class="franja-corta" aria-hidden="true"></span><blockquote><p>{es ? '«Queremos seguir la línea de mi abuelo y de mi padre, pero con una creatividad y con unas formas diferentes».' : '“We want to follow the line of my grandfather and my father, but with our own creativity and different forms.”'}</p></blockquote><figcaption>Felipe Linares Vargas</figcaption></figure>
      <div class="botones"><a class="boton boton-principal" href={route('legacy', lang)}>{ui.cta.legacy}</a><a class="boton boton-secundario" style="color:var(--blanco);border-color:var(--blanco)" href={route('archive', lang)}>{ui.nav.archive}</a></div>
    </div>
  </section>

  <!-- TALLER / CONTACTO -->
  <section class="seccion seccion-crema" id="taller" aria-labelledby="titulo-taller">
    <div class="contenedor dos-columnas" style="align-items:center">
      <div>
        <p class="antetitulo">{es ? 'El taller' : 'The workshop'}</p>
        <h2 id="titulo-taller">{S[7].heading}</h2>
        <p class="texto-suave">{S[7].text}</p>
        <ul class="contacto-lista">
          <li><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg><div><strong>{es ? 'Taller' : 'Workshop'}</strong>{site.workshopArea[lang]}</div></li>
          <li><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg><div><strong>{es ? 'Contacto directo' : 'Direct contact'}</strong>{site.contactEmail || site.whatsappNumber ? [site.contactEmail, site.whatsappNumber].filter(Boolean).join(' · ') : ui.contact.pendingContact}</div></li>
        </ul>
        <div class="botones"><a class="boton boton-principal" href={route('contact', lang)}>{ui.cta.contact}</a></div>
      </div>
      <figure class="foto"><Image src={tallerImg} alt={es ? 'Alebrije de cabeza negra y astas sobre la mesa del taller familiar, entre frascos de pintura y pinceles.' : 'Black-headed, antlered alebrije on the family workshop table, among paint jars and brushes.'} widths={[480, 800]} sizes="(max-width: 820px) 100vw, 34rem" loading="lazy" style="aspect-ratio:4/5;object-fit:cover" /><figcaption>{es ? 'Fotografía del taller familiar.' : 'Photograph of the family workshop.'}</figcaption></figure>
    </div>
  </section>

  <!-- PARA LEER MÁS -->
  <section class="seccion" id="prensa" aria-labelledby="titulo-prensa">
    <div class="contenedor">
      <div class="encabezado-seccion">
        <p class="antetitulo">{es ? 'Prensa y publicaciones' : 'Press and publications'}</p>
        <h2 id="titulo-prensa">{es ? 'Para leer más' : 'Further reading'}</h2>
      </div>
      <ul class="prensa">
        {prensa.map((a) => <li><a href={archivePath(a.id, lang)}>{a.data.title[lang]}</a><span>{[a.data.institution, a.data.year].filter(Boolean).join(' · ')}</span></li>)}
      </ul>
      <div class="botones"><a class="boton boton-secundario" href={route('archive', lang)}>{es ? 'Ver el archivo completo' : 'See the full archive'}</a></div>
    </div>
  </section>
  <Lightbox lang={lang} />
</Base>

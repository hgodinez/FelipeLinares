---
import { Image, getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Macro from '@/components/Macro.astro';
import Marquee from '@/components/Marquee.astro';
import Paper from '@/components/Paper.astro';
import { t } from '@/i18n/ui';
import { route, alternates, workPath, type Lang } from '@/i18n/routes';
import { getPage, getPeople } from '@/lib/content';
import site from '@/data/site.json';
import heroImg from '@/assets/works/alebrije-tigre-frente.jpg';
import tigreCenital from '@/assets/works/alebrije-tigre-cenital.jpg';
import heroMobile from '@/assets/works/alebrije-tigre-cenital.jpg';
import jaguarRepisa from '@/assets/works/alebrije-astado-repisa.jpg';
import ranaFrente from '@/assets/works/alebrije-rana-frente.jpg';
import calaveraMesa from '@/assets/works/jinete-calavera-mesa.jpg';
import catrina from '@/assets/works/catrina-emplumada-taller.jpg';
import mTigreRugido from '@/assets/macro/tigre-rugido.jpg';
import mJaguarColmillos from '@/assets/macro/jaguar-colmillos.jpg';
import mJaguarRostro from '@/assets/macro/jaguar-rostro.jpg';
import mJaguarEscamas from '@/assets/macro/jaguar-escamas.jpg';
import mJaguarAlas from '@/assets/macro/jaguar-alas.jpg';
import mRanaOjo from '@/assets/macro/rana-ojo.jpg';
import mRanaLomo from '@/assets/macro/rana-lomo.jpg';
import mTigreAlas from '@/assets/macro/tigre-alas.jpg';
import mSerpiente from '@/assets/macro/tigre-serpiente-ala.jpg';
import mCalaveraRostro from '@/assets/macro/calavera-rostro.jpg';
import mCalaveraMontura from '@/assets/macro/calavera-montura.jpg';
import mCatrina from '@/assets/macro/catrina-rostro.jpg';
import tallerFrente from '@/assets/works/alebrije-astado-frente-taller.jpg';
import tallerCenital from '@/assets/works/alebrije-astado-cenital-taller.jpg';
import tallerJinete from '@/assets/works/jinete-calavera-taller.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const h = ui.home;
const page = await getPage('inicio', lang);
const taller = await getPage('taller', lang);
const stages = taller.data.sections ?? [];
const people = await getPeople();
const byId = Object.fromEntries(people.map((p) => [p.id, p]));
const lineage = ['pedro-linares-lopez', 'felipe-linares-mendoza', 'felipe-linares-vargas'].map((id) => byId[id]).filter(Boolean);
const w = async (id: string) => (await getEntry('artworks', id))!;
const jaguar = await w('alebrije-jaguar-astado');
const rana = await w('alebrije-rana-picuda');
const calavera = await w('calavera-alada-sobre-alebrije');
const catrinaW = await w('catrina-con-tocado-de-plumas');
const tigre = await w('alebrije-tigre-alado');
const tzompantli = await w('tzompantli-2010');
const og = await getImage({ src: heroImg, width: 1200, format: 'jpg' });
const es = lang === 'es';

const encounters = [
  { work: jaguar, img: jaguarRepisa, macro: mJaguarColmillos, macro2: mJaguarAlas, pos: '55% 45%', line: es ? 'Astas de venado. Alas de murciélago. Garras verdes. Lengua de fuego.' : 'Deer antlers. Bat wings. Green claws. A tongue of fire.' },
  { work: rana, img: ranaFrente, macro: mRanaOjo, macro2: mRanaLomo, pos: '50% 55%', line: es ? 'Cuerpo de rana. Pico de ave. Orejas que se abren como pétalos.' : 'A frog’s body. A bird’s beak. Ears that open like petals.' },
  { work: calavera, img: calaveraMesa, macro: mCalaveraRostro, macro2: mCalaveraMontura, pos: '50% 40%', line: es ? 'Una calavera con alas de monarca cabalga sobre una criatura de cuernos morados.' : 'A monarch-winged skull rides a creature with purple horns.' },
  { work: catrinaW, img: catrina, macro: mCatrina, macro2: null, pos: '50% 30%', line: es ? 'Sombrero de rosas, chal de plumas y dos grandes alas azules.' : 'A hat of roses, a feather shawl and two great blue wings.' },
  { work: tigre, img: tigreCenital, macro: mTigreAlas, macro2: mSerpiente, pos: '50% 35%', line: es ? 'Rugido de tigre, manchas de jaguar, alas de ave y una cola que vigila.' : 'A tiger’s roar, a jaguar’s spots, a bird’s wings and a tail that keeps watch.' },
];
const personLd = { '@context': 'https://schema.org', '@type': 'Person', name: 'Felipe Linares Vargas', jobTitle: es ? 'Cartonero' : 'Cartonería artist', description: site.defaultDescription[lang], url: new URL(route('home', lang), Astro.site).toString(), address: { '@type': 'PostalAddress', addressLocality: 'Ciudad de México', addressCountry: 'MX' }, knowsAbout: ['Cartonería', 'Alebrijes', 'Arte popular mexicano'] };
---
<Base lang={lang} title={site.artistName} description={page.data.seoDescription} alternates={alternates('home')} ogImage={og.src} jsonLd={personLd} overlayHeader topScene="ink">

  <!-- 01 · EL ENCUENTRO: the creature fills the screen -->
  <Macro src={heroImg} alt={es ? 'Alebrije con cabeza de tigre rugiendo, cuerpo moteado de jaguar, alas negras y patas escamosas rosadas, de frente.' : 'Alebrije with a roaring tiger head, jaguar-spotted body, black wings and pink scaled legs, facing the viewer.'} srcMobile={heroMobile} scrim="bottom" position="62% 38%" positionMobile="50% 18%" minHeight="100svh" eager class="hero" labelledby="hero-title">
    <div class="container hero__inner">
      <p class="eyebrow hero__eyebrow">{ui.tagline}</p>
      <h1 id="hero-title" class="giant hero__name on-photo">Felipe<br />Linares<br />Vargas</h1>
      <div class="hero__row">
        <p class="lead on-photo hero__intro">{h.heroIntro}</p>
        <div class="hero__actions">
          <a class="btn btn--lime btn--xl" href={route('works', lang)}>{ui.cta.works} <span class="arrow" aria-hidden="true">↗</span></a>
          <a class="link-arrow hero__secondary" href={route('artist', lang)}>{ui.cta.artist} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <p class="micro hero__caption">{h.stageCaption.replace(es ? 'Alebrije de tigre alado con cola de serpiente' : 'Winged tiger alebrije with serpent tail', tigre.data.title[lang])}</p>
    </div>
  </Macro>

  <div class="scene-lime concept bleed">
    <Marquee items={[h.heroStatement, h.ch2Title, h.ch3Title, h.ch4Title, h.ch5Title]} />
  </div>

  <!-- 02 · LAS CRIATURAS: five full-width encounters -->
  <section id="criaturas" class="creatures scene-ink" aria-labelledby="creatures-title">
    <div class="container creatures__head">
      <p class="eyebrow eyebrow--accent rise">02 · {h.ch2}</p>
      <h2 id="creatures-title" class="giant rise" style="--delay:80ms">{h.ch2Title}</h2>
      <p class="lead rise" style="--delay:160ms">{h.ch2Text}</p>
    </div>

    {encounters.map((e, i) => (
      <article class:list={['encounter', `encounter--${i + 1}`, { 'encounter--flip': i % 2 === 1 }]}>
        <a class="encounter__link" href={workPath(e.work.id, lang)} data-work-link={e.work.id} aria-label={`${ui.cta.viewWork}: ${e.work.data.title[lang]}`}>
          <div class="encounter__main zoom-in">
            <Image src={e.img} alt="" widths={[640, 1024, 1600, 2200]} sizes="(max-width: 900px) 100vw, 66vw" loading={i === 0 ? 'eager' : 'lazy'} style={`object-position:${e.pos}`} transition:name={`work-${e.work.id}`} />
          </div>
          <div class="encounter__macros">
            <div class="encounter__macro wipe"><Image src={e.macro} alt="" widths={[480, 800, 1200]} sizes="(max-width: 900px) 50vw, 34vw" loading="lazy" /></div>
            {e.macro2 && <div class="encounter__macro wipe" style="--delay:160ms"><Image src={e.macro2} alt="" widths={[480, 800, 1200]} sizes="(max-width: 900px) 50vw, 34vw" loading="lazy" /></div>}
          </div>
          <div class="encounter__text">
            <span class="num" aria-hidden="true">0{i + 1}</span>
            <h3 class="encounter__title on-photo">{e.work.data.title[lang]}{e.work.data.titleStatus === 'provisional' && <span class="encounter__flag" aria-hidden="true">*</span>}</h3>
            <p class="encounter__line on-photo">{e.line}</p>
            <span class="btn btn--lime encounter__cta" aria-hidden="true">{ui.cta.viewWork} <span class="arrow">↗</span></span>
          </div>
        </a>
      </article>
    ))}

    <div class="container creatures__all">
      <p class="small muted"><span style="color:var(--color-coral)">*</span> {ui.works.provisional}.</p>
      <a class="btn btn--paper btn--xl" href={route('works', lang)}>{ui.cta.allWorks} <span class="arrow" aria-hidden="true">↗</span></a>
    </div>
  </section>

  <!-- 03 · LAS MANOS QUE LAS CREAN -->
  <Macro src={mJaguarRostro} alt={es ? 'Primer plano del rostro negro del alebrije de jaguar, con ojos ámbar, orejas rojas y pelaje pintado a pincel.' : 'Close-up of the jaguar alebrije’s black face, with amber eyes, red ears and brush-painted fur.'} scrim="left" position="60% 40%" minHeight="90svh" labelledby="hands-title">
    <div class="container hands__inner">
      <p class="eyebrow rise">03 · {h.ch3}</p>
      <h2 id="hands-title" class="rise on-photo" style="--delay:80ms">{h.ch3Title}</h2>
      <p class="lead on-photo rise" style="--delay:160ms">{h.ch3Text}</p>
      <p class="small rise hands__note" style="--delay:220ms">{h.ch3Note}</p>
      <a class="btn btn--lime btn--xl rise" style="--delay:280ms" href={route('artist', lang)}>{ui.cta.artist} <span class="arrow" aria-hidden="true">↗</span></a>
    </div>
  </Macro>

  <!-- 04 · DE PAPEL A IMPOSIBLE -->
  <section class="process scene-cobalt" aria-labelledby="process-title">
    <div class="container process__head">
      <p class="eyebrow rise">04 · {h.ch4}</p>
      <h2 id="process-title" class="giant rise" style="--delay:80ms">{h.ch4Title}</h2>
      <p class="lead rise" style="--delay:160ms">{h.ch4Text}</p>
    </div>
    <ol class="stations">
      {stages.map((s, i) => (
        <li class:list={['station', { 'station--photo': i >= 3 }]}>
          <div class="container station__grid">
            <div class="station__text">
              <span class="num station__num" aria-hidden="true">0{i + 1}</span>
              <h3 class="rise">{s.heading}</h3>
              <p class="rise" style="--delay:80ms">{s.text}</p>
              {s.note && i < 3 && <p class="small station__pending rise" style="--delay:140ms">{s.note}</p>}
            </div>
            <div class="station__media">
              {i === 0 && <div class="sheet"><Paper tone="lime" cut="a" fold="tr" class="station__card"><Image src={mJaguarEscamas} alt={es ? 'Garras verdes escamosas con uñas de marfil, detalle de superficie pintada.' : 'Green scaled claws with ivory nails, painted surface detail.'} widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 44vw" loading="lazy" /></Paper></div>}
              {i === 1 && <div class="sheet"><Paper tone="light" cut="c" class="station__card"><Image src={mJaguarAlas} alt={es ? 'Astas y alas rojas del alebrije de jaguar: lo que la estructura sostiene.' : 'Antlers and red wings of the jaguar alebrije: what the armature holds up.'} widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 44vw" loading="lazy" /></Paper></div>}
              {i === 2 && <div class="sheet"><Paper tone="coral" cut="b" fold="bl" class="station__card"><Image src={tallerFrente} alt={es ? 'Alebrije a medio terminar sobre la mesa del taller.' : 'Half-finished alebrije on the workshop table.'} widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 44vw" loading="lazy" /></Paper></div>}
              {i === 3 && <div class="station__pair"><div class="zoom-in"><Image src={tallerCenital} alt={es ? 'Alas rojas con nervaduras pintadas, vista cenital en el taller.' : 'Red wings with painted veins, overhead view in the workshop.'} widths={[600, 1000]} sizes="(max-width: 900px) 50vw, 24vw" loading="lazy" /></div><div class="zoom-in"><Image src={tallerJinete} alt={es ? 'Esqueleto alado sobre criatura anaranjada, en proceso de pintura.' : 'Winged skeleton on an orange creature, being painted.'} widths={[600, 1000]} sizes="(max-width: 900px) 50vw, 24vw" loading="lazy" /></div></div>}
              {i === 4 && <div class="zoom-in station__final"><Image src={mTigreRugido} alt={es ? 'Rostro del tigre alado terminado: rayas, colmillos y lengua.' : 'Face of the finished winged tiger: stripes, fangs and tongue.'} widths={[640, 1000, 1400]} sizes="(max-width: 900px) 100vw, 50vw" loading="lazy" /></div>}
            </div>
          </div>
        </li>
      ))}
    </ol>
    <div class="container process__foot">
      <p class="small process__note">{h.ch4Note}</p>
      <a class="btn btn--lime btn--xl" href={route('workshop', lang)}>{ui.cta.process} <span class="arrow" aria-hidden="true">↗</span></a>
    </div>
  </section>

  <!-- 05 · UNA HISTORIA QUE CONTINÚA -->
  <Macro src={mTigreAlas} alt={es ? 'Alas negras y lomo moteado del alebrije de tigre, vistos desde arriba.' : 'Black wings and spotted back of the tiger alebrije, seen from above.'} scrim="top" position="50% 50%" minHeight="auto" class="story" labelledby="story-title">
    <div class="container story__inner">
      <header class="story__head">
        <p class="eyebrow rise">05 · {h.ch5}</p>
        <h2 id="story-title" class="giant on-photo rise" style="--delay:80ms">{h.ch5Title}</h2>
        <p class="lead on-photo rise" style="--delay:160ms">{h.ch5Text}</p>
      </header>
      <ol class="strips">
        {lineage.map((p, i) => (
          <li class="strip rise" style={`--delay:${i * 90}ms`}>
            <div class="sheet--near"><Paper tone={i === lineage.length - 1 ? 'lime' : 'light'} cut={(['a', 'c', 'b'] as const)[i]} class="strip__paper">
              <span class="micro">{p.data.born ? `${p.data.born}${p.data.died ? `–${p.data.died}` : ''}` : (es ? 'Generación actual' : 'Current generation')}</span>
              <h3 class="strip__name">{p.data.name}</h3>
              <p class="small">{p.data.role[lang]}</p>
              <a class="link-arrow" href={p.data.isFeaturedArtist ? route('artist', lang) : `${route('legacy', lang)}#tree-title`}>{p.data.isFeaturedArtist ? ui.cta.artist : (es ? 'Ver semblanza' : 'View profile')} <span class="arrow" aria-hidden="true">→</span></a>
            </Paper></div>
          </li>
        ))}
        <li class="strip rise" style="--delay:270ms">
          <div class="sheet--near"><Paper tone="cobalt" cut="d" class="strip__paper">
            <span class="micro">{ui.archive.types.collection} · 2010</span>
            <h3 class="strip__name">Tzompantli</h3>
            <p class="small">{tzompantli.data.collection} · {tzompantli.data.dimensions}</p>
            <a class="link-arrow" href={workPath(tzompantli.id, lang)}>{ui.cta.viewWork} <span class="arrow" aria-hidden="true">→</span></a>
          </Paper></div>
        </li>
      </ol>
      <a class="btn btn--paper btn--xl story__cta" href={route('legacy', lang)}>{ui.cta.legacy} <span class="arrow" aria-hidden="true">↗</span></a>
    </div>
  </Macro>

  <!-- 06 · EL PRÓXIMO ENCUENTRO -->
  <section class="encounter-end scene-coral" aria-labelledby="encounter-title">
    <div class="container encounter-end__inner">
      <p class="eyebrow rise">06 · {h.ch6}</p>
      <h2 id="encounter-title" class="giant rise" style="--delay:80ms">{h.ch6Title}</h2>
      <p class="lead rise" style="--delay:160ms">{h.ch6Text}</p>
      <a class="btn btn--ink btn--xl rise" style="--delay:240ms" href={route('contact', lang)}>{ui.cta.contact} <span class="arrow" aria-hidden="true">↗</span></a>
    </div>
    <div class="encounter-end__macro wipe"><Image src={mCalaveraMontura} alt="" widths={[640, 1024, 1600]} sizes="100vw" loading="lazy" /></div>
  </section>
</Base>

<style>
  /* 01 */
  .hero :global(.macro__content) { display: grid; align-content: end; min-height: 100svh; }
  .hero__inner { padding-top: calc(var(--nav-h) + var(--space-l)); padding-bottom: var(--space-l); }
  .hero__eyebrow { color: var(--color-lime); }
  .hero__name { max-width: 12ch; }
  .hero__row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-m) var(--space-xl); align-items: end; margin-top: var(--space-m); }
  .hero__intro { max-width: 34ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-s) var(--space-m); align-items: center; }
  .hero__secondary { color: var(--color-paper); }
  .hero__secondary:hover { border-bottom-color: var(--color-lime); }
  .hero__caption { margin-top: var(--space-m); color: rgba(247, 247, 242, 0.6); text-transform: none; letter-spacing: 0.02em; }
  @media (prefers-reduced-motion: no-preference) {
    .hero :global(.macro__img img) { animation: hero-zoom 1400ms var(--ease-paper) both; }
    .hero__name { animation: hero-rise 700ms var(--ease-paper) 120ms both; }
    .hero__row, .hero__caption { animation: hero-rise 700ms var(--ease-paper) 320ms both; }
  }
  @keyframes hero-zoom { from { transform: scale(1.12); } to { transform: scale(1); } }
  @keyframes hero-rise { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: none; } }

  .concept { padding-block: var(--space-s); }

  /* 02 */
  .creatures { padding-top: var(--space-2xl); }
  .creatures__head { margin-bottom: var(--space-xl); }
  .creatures__head h2 { color: var(--color-lime); max-width: 10ch; }
  .creatures__head .lead { margin-top: var(--space-m); }
  .encounter { position: relative; margin-bottom: 6px; }
  .encounter__link { display: grid; grid-template-columns: 2fr 1fr; grid-template-rows: auto; text-decoration: none; color: inherit; min-height: 92svh; position: relative; }
  .encounter--flip .encounter__link { grid-template-columns: 1fr 2fr; }
  .encounter--flip .encounter__main { order: 2; }
  .encounter__main { position: relative; overflow: hidden; background: var(--ink-soft); }
  .encounter__main :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .encounter__macros { display: grid; grid-template-rows: 1fr 1fr; gap: 6px; }
  .encounter__macro { overflow: hidden; background: var(--ink-soft); }
  .encounter__macro :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease-paper); }
  .encounter--4 .encounter__macros { grid-template-rows: 1fr; }
  .encounter__text { position: absolute; left: 0; right: 0; bottom: 0; padding: var(--space-xl) var(--gutter) var(--space-l); background: linear-gradient(to top, rgba(25, 27, 36, 0.9), rgba(25, 27, 36, 0.55) 55%, transparent); display: grid; gap: var(--space-s); align-items: end; grid-template-columns: minmax(0, 1fr) auto; pointer-events: none; }
  .encounter__text .num { position: absolute; right: var(--gutter); top: -0.15em; color: var(--color-lime); opacity: 0.35; }
  .encounter__title { font-size: var(--type-h2); max-width: 14ch; grid-column: 1; }
  .encounter__flag { color: var(--color-coral); }
  .encounter__line { grid-column: 1; max-width: 40ch; font-size: var(--type-lead); font-weight: 500; }
  .encounter__cta { grid-column: 2; grid-row: 1 / 3; align-self: end; pointer-events: none; }
  .encounter__link:hover .encounter__main :global(img), .encounter__link:focus-visible .encounter__main :global(img) { transform: scale(1.03); }
  .encounter__link:hover .encounter__macro :global(img) { transform: scale(1.06); }
  .encounter__link:hover .encounter__cta { background: var(--lime-deep); }
  .encounter__link:focus-visible { outline: 4px solid var(--color-lime); outline-offset: -4px; }
  .creatures__all { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-m); padding-block: var(--space-xl); }

  /* 03 */
  .hands__inner { padding-block: var(--space-2xl); max-width: 60ch; min-height: 90svh; display: grid; align-content: center; gap: var(--space-m); }
  .hands__inner h2 { font-size: var(--type-h2); }
  .hands__note { color: rgba(247, 247, 242, 0.75); max-width: 44ch; }

  /* 04 */
  .process { padding-block: var(--space-2xl) var(--space-xl); }
  .process__head { margin-bottom: var(--space-xl); }
  .process__head h2 { color: var(--color-lime); max-width: 12ch; }
  .process__head .lead { margin-top: var(--space-m); }
  .stations { list-style: none; margin: 0; padding: 0; }
  .station { padding-block: var(--space-xl); border-top: 1.5px solid rgba(247, 247, 242, 0.25); }
  .station__grid { display: grid; grid-template-columns: 5fr 7fr; gap: var(--space-l) var(--gutter); align-items: center; }
  .station:nth-child(even) .station__text { order: 2; }
  .station__num { display: block; color: var(--color-lime); opacity: 0.9; font-size: clamp(4rem, 2rem + 8vw, 9rem); margin-bottom: var(--space-s); }
  .station__text h3 { font-size: var(--type-h2); margin-bottom: var(--space-s); }
  .station__pending { margin-top: var(--space-s); color: var(--color-lime); font-weight: 700; }
  .station__card { padding: 14px; }
  .station__card :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  .station__pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-s); align-items: start; }
  .station__pair > :last-child { margin-top: var(--space-xl); }
  .station__pair :global(img), .station__final :global(img) { width: 100%; height: auto; }
  .station__pair > div, .station__final { overflow: hidden; }
  .process__foot { display: grid; gap: var(--space-m); justify-items: start; padding-top: var(--space-l); }
  .process__note { color: rgba(247, 247, 242, 0.75); max-width: 60ch; }

  /* 05 */
  .story :global(.macro__content) { padding-block: var(--space-2xl); }
  .story__head { max-width: 60ch; margin-bottom: var(--space-xl); }
  .story__head h2 { font-size: var(--type-hero); }
  .story__head .lead { margin-top: var(--space-m); }
  .strips { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-m); align-items: end; }
  .strip:nth-child(2) { margin-bottom: var(--space-l); }
  .strip:nth-child(3) { margin-bottom: var(--space-xl); }
  .strip__paper { padding: var(--space-m) var(--space-m) var(--space-l); display: grid; gap: 0.35rem; min-height: 240px; align-content: start; }
  .strip__name { font-size: var(--type-h3); }
  .story__cta { margin-top: var(--space-xl); }

  /* 06 */
  .encounter-end { position: relative; overflow: hidden; display: grid; grid-template-columns: 1fr 1fr; min-height: 80svh; }

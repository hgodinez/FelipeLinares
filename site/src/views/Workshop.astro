---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Lightbox from '@/components/Lightbox.astro';
import { getImage } from 'astro:assets';
import { t } from '@/i18n/ui';
import { alternates, route, type Lang } from '@/i18n/routes';
import { getPage } from '@/lib/content';
import img1 from '@/assets/works/alebrije-astado-frente-taller.jpg';
import img2 from '@/assets/works/alebrije-astado-cenital-taller.jpg';
import img3 from '@/assets/works/jinete-calavera-taller.jpg';
import img4 from '@/assets/works/alebrije-astado-perfil-taller.jpg';
import img5 from '@/assets/works/catrina-emplumada-taller.jpg';
import done from '@/assets/works/jinete-calavera-mesa.jpg';
import pintandoImg from '@/assets/video/felipe-pintando.webp';
import cabezaImg from '@/assets/video/felipe-cabeza-astada.webp';
import contraluzImg from '@/assets/video/alebrije-astado-contraluz.webp';
import mEscamas from '@/assets/macro/jaguar-escamas.jpg';
import mAlas from '@/assets/macro/jaguar-alas.jpg';
import mColmillos from '@/assets/macro/jaguar-colmillos.jpg';
import mRanaLomo from '@/assets/macro/rana-lomo.jpg';
import mRanaOjo from '@/assets/macro/rana-ojo.jpg';
import mTigreAlas from '@/assets/macro/tigre-alas.jpg';
import mSerpiente from '@/assets/macro/tigre-serpiente.jpg';
import mCalavera from '@/assets/macro/calavera-rostro.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const es = lang === 'es';
const page = await getPage('taller', lang);
const { Content } = await render(page);
const pasos = page.data.sections ?? [];
const fotos = [
  { src: img1, alt: { es: 'Alebrije de cabeza negra y astas en la mesa del taller, con frascos de pintura y pinceles al fondo.', en: 'Black-headed, antlered alebrije on the workshop table, with paint jars and brushes behind.' } },
  { src: img2, alt: { es: 'Vista cenital del alebrije en el taller: alas rojas extendidas y cuerpo moteado.', en: 'Overhead view of the alebrije in the workshop: red wings spread and spotted body.' } },
  { src: img3, alt: { es: 'Esqueleto con alas de mariposa montado en una criatura anaranjada, en proceso entre vasos y pinceles.', en: 'Skeleton with butterfly wings riding an orange creature, in progress among cups and brushes.' } },
  { src: img4, alt: { es: 'Vista lateral del alebrije de jaguar con astas: cola enroscada, ala y patas verdes.', en: 'Side view of the antlered jaguar alebrije: coiled tail, wing and green legs.' } },
  { src: img5, alt: { es: 'Catrina con tocado de plumas sobre base roja, rodeada de piezas terminadas y en proceso.', en: 'Catrina with feathered headdress on a red base, surrounded by finished and in-progress pieces.' } },
  { src: done, alt: { es: 'Esqueleto alado sobre alebrije, terminado y con riendas, sobre una mesa.', en: 'Winged skeleton on an alebrije, finished and with reins, on a table.' } },
  { src: cabezaImg, alt: { es: 'Felipe Linares Vargas observa de cerca una cabeza de alebrije en proceso: cuernos grises y melena de tiras anaranjadas. Fotograma de video.', en: 'Felipe Linares Vargas looks closely at an alebrije head in progress: grey horns and a mane of orange strips. Video still.' } },
  { src: contraluzImg, alt: { es: 'Alebrije con cabeza de cabra y cuernos rayados, a contraluz en el taller; su sombra se proyecta en la pared. Fotograma de video.', en: 'Alebrije with a goat head and striped horns, against the light in the workshop; its shadow falls on the wall. Video still.' } },
];
const fotosFull = await Promise.all(fotos.map(async (f) => ({ ...f, full: (await getImage({ src: f.src, width: Math.min(1600, f.src.width), format: 'webp', quality: 82 })).src })));
const detalles = [
  { img: mEscamas, t: es ? 'Escamas y uñas' : 'Scales and nails', d: es ? 'Garras verdes cubiertas de escamas pintadas una por una; las uñas, de marfil.' : 'Green claws covered in scales painted one by one; ivory nails.' },
  { img: mAlas, t: es ? 'Nervaduras' : 'Wing veins', d: es ? 'Alas de murciélago en rojo con las nervaduras trazadas en blanco sobre la pintura seca.' : 'Red bat wings with veins traced in white over the dry paint.' },
  { img: mColmillos, t: es ? 'Colmillos y lengua' : 'Tusks and tongue', d: es ? 'Colmillos curvos modelados en papel y una lengua larga en bermellón.' : 'Curved tusks modeled in paper and a long vermilion tongue.' },
  { img: mRanaLomo, t: es ? 'Puntos sobre verde' : 'Dots on green', d: es ? 'Puntos de dos tamaños que dan textura a un volumen liso.' : 'Dots of two sizes giving texture to a smooth volume.' },
  { img: mRanaOjo, t: es ? 'Ojo y pico' : 'Eye and beak', d: es ? 'Cabeza de ave sobre cuerpo de rana; el cuello escamado en azul y oro.' : 'A bird’s head on a frog’s body; the neck scaled in blue and gold.' },
  { img: mTigreAlas, t: es ? 'Manchas de jaguar' : 'Jaguar spots', d: es ? 'Rosetas negras sobre naranja a lo largo de todo el cuerpo.' : 'Black rosettes on orange along the whole body.' },
  { img: mSerpiente, t: es ? 'Cola de serpiente' : 'Serpent tail', d: es ? 'La cola del tigre termina en una cabeza de serpiente de ojos amarillos.' : 'The tiger’s tail ends in a yellow-eyed serpent head.' },
  { img: mCalavera, t: es ? 'Alas de monarca' : 'Monarch wings', d: es ? 'Una calavera con alas de mariposa monarca en naranja, negro y violeta.' : 'A skull with monarch-butterfly wings in orange, black and violet.' },
];
---
<Base lang={lang} title={page.data.title} description={page.data.seoDescription} alternates={alternates('workshop')}>
  <section class="portada" aria-labelledby="titulo-taller">
    <div class="contenedor">
      <div>
        <p class="antetitulo">{page.data.eyebrow}</p>
        <h1 id="titulo-taller">{page.data.title}</h1>
        <p class="lema">{es ? 'Papel, engrudo, volumen y pintura.' : 'Paper, paste, volume and paint.'}</p>
        <p class="entrada">{page.data.lead}</p>
        <div class="botones"><a class="boton boton-principal" href="#pasos">{es ? 'Ver los pasos' : 'See the steps'}</a><a class="boton boton-secundario" href={route('works', lang)}>{ui.cta.works}</a></div>
      </div>
      <figure class="portada-imagen" data-reveal="zoom" style="--i:1">
        <div class="portada-marco"><Image src={pintandoImg} alt={es ? 'Felipe Linares Vargas pinta con un pincel fino en la mesa del taller; a su lado, un alebrije con cuernos y melena multicolor.' : 'Felipe Linares Vargas paints with a fine brush at the workshop table; beside him, a horned alebrije with a multicolored mane.'} widths={[480, 960, 1400]} sizes="(max-width: 440px) 88vw, (max-width: 760px) 24rem, 30rem" loading="eager" fetchpriority="high" style="aspect-ratio:4/3;object-position:60% 50%" /></div>
        <figcaption>{es ? 'Felipe pintando en el taller familiar · fotograma de video' : 'Felipe painting in the family workshop · video still'}</figcaption>
      </figure>
    </div>
  </section>

  <section class="seccion seccion-crema" id="pasos" aria-labelledby="titulo-pasos">
    <div class="contenedor">
      <div class="encabezado-seccion prosa" data-reveal><p class="antetitulo">{es ? 'Del papel a la criatura' : 'From paper to creature'}</p><h2 id="titulo-pasos">{es ? 'Así se construye una pieza' : 'How a piece is built'}</h2><Content /></div>
      <ol class="pasos">{pasos.map((p, i) => <li data-reveal style={`--i:${i}`}><h3>{p.heading}</h3><p>{p.text}</p>{p.note && <p class="pendiente">{p.note}</p>}</li>)}</ol>
      <div class="nota"><p><strong>{es ? '¿Cuánto tarda una pieza?' : 'How long does a piece take?'}</strong> {es ? 'Cada capa de papel se seca antes de la siguiente, a veces durante días. Las piezas grandes requieren semanas de secado y pintura.' : 'Each layer of paper dries before the next, sometimes for days. Large pieces need weeks of drying and painting.'}</p></div>
    </div>
  </section>

  <section class="seccion" aria-labelledby="titulo-detalle">
    <div class="contenedor">
      <div class="encabezado-seccion" data-reveal><p class="antetitulo">{es ? 'En detalle' : 'In detail'}</p><h2 id="titulo-detalle">{es ? 'Acercamientos a la pintura' : 'Close-ups of the painting'}</h2><p class="texto-suave">{es ? 'Recortes de las fotografías de las obras, sin ampliación artificial.' : 'Crops from the photographs of the works, without artificial enlargement.'}</p></div>
      <ul class="detalles">{detalles.map((d, i) => <li data-reveal="zoom" style={`--i:${i % 4}`}><figure><Image src={d.img} alt={d.d} widths={[360, 600]} sizes="(max-width: 1000px) 45vw, 17rem" loading="lazy" /><figcaption><strong>{d.t}</strong>{d.d}</figcaption></figure></li>)}</ul>
    </div>
  </section>

  <section class="seccion seccion-oscura" aria-labelledby="titulo-fotos">
    <div class="contenedor">
      <div class="encabezado-seccion" data-reveal><p class="antetitulo">{es ? 'Fotografías de taller' : 'Workshop photographs'}</p><h2 id="titulo-fotos">{es ? 'Entre frascos, pinceles y piezas a medio secar' : 'Among jars, brushes and half-dried pieces'}</h2><p class="texto-suave">{ui.home.ch4Note}</p></div>
      <ul class="piezas" data-lb-group>
        {fotosFull.map((f) => <li class="pieza" data-reveal data-tilt="7"><a class="pieza-imagen" href={f.full} data-lb-open data-full={f.full} data-alt={f.alt[lang]} data-title={es ? 'Taller' : 'Workshop'} data-caption={f.alt[lang]}><Image src={f.src} alt={f.alt[lang]} widths={[360, 600]} sizes="(max-width: 560px) 45vw, 22rem" loading="lazy" /></a></li>)}
        <li class="pieza" data-reveal data-tilt="7"><div class="marcador" style="aspect-ratio:3/4;border-radius:10px"><strong>{es ? 'Video del proceso' : 'Process video'}</strong><span>{es ? 'Por incorporar con autorización del artista.' : 'To be added with the artist’s permission.'}</span></div></li>
      </ul>
      <div class="nota-oscura"><p class="nota-titulo">{es ? 'Lo que falta por documentar' : 'What remains to be documented'}</p><p>{es ? 'Materiales sobre la mesa, la armadura de una pieza y las capas de papel antes de la pintura. Se fotografiarán en el taller de Felipe con su autorización.' : 'Materials on the table, the armature of a piece and the paper layers before painting. They will be photographed in Felipe’s workshop with his permission.'}</p></div>
    </div>
  </section>
  <Lightbox lang={lang} />
</Base>
<style>.prosa :global(p) { max-width: 46rem; }</style>

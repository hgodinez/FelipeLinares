---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Placeholder from '@/components/Placeholder.astro';
import { t } from '@/i18n/ui';
import { alternates, route, type Lang } from '@/i18n/routes';
import { getPage } from '@/lib/content';
import img1 from '@/assets/works/alebrije-astado-frente-taller.jpg';
import img2 from '@/assets/works/alebrije-astado-cenital-taller.jpg';
import img3 from '@/assets/works/jinete-calavera-taller.jpg';
import img4 from '@/assets/works/alebrije-astado-perfil-taller.jpg';
import img5 from '@/assets/works/catrina-emplumada-taller.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const page = await getPage('taller', lang);
const { Content } = await render(page);
const steps = page.data.sections ?? [];
const photos = [
  { src: img1, alt: { es: 'Alebrije de cabeza negra y astas en la mesa del taller, con frascos de pintura y pinceles al fondo.', en: 'Black-headed, antlered alebrije on the workshop table, with paint jars and brushes behind.' } },
  { src: img2, alt: { es: 'Vista cenital del alebrije en el taller: alas rojas extendidas, cuerpo moteado y periódicos bajo la mesa.', en: 'Overhead view of the alebrije in the workshop: red wings spread, spotted body and newspapers under the table.' } },
  { src: img3, alt: { es: 'Esqueleto con alas de mariposa montado en una criatura anaranjada, en proceso entre vasos y pinceles.', en: 'Skeleton with butterfly wings riding an orange creature, in progress among cups and brushes.' } },
  { src: img4, alt: { es: 'Vista lateral del alebrije de jaguar con astas: cola enroscada, ala de murciélago y patas verdes.', en: 'Side view of the antlered jaguar alebrije: coiled tail, bat wing and green legs.' } },
  { src: img5, alt: { es: 'Catrina con tocado de plumas sobre base roja, rodeada de piezas terminadas y en proceso.', en: 'Catrina with feathered headdress on a red base, surrounded by finished and in-progress pieces.' } },
];
---
<Base lang={lang} title={page.data.title} description={page.data.seoDescription} alternates={alternates('workshop')}>
  <section class="section ws-hero">
    <div class="container grid">
      <div class="col-6">
        <p class="eyebrow eyebrow--accent reveal">{page.data.eyebrow}</p>
        <h1 class="reveal" style="--delay:80ms">{page.data.title}</h1>
        <p class="lead mt-l reveal" style="--delay:160ms">{page.data.lead}</p>
      </div>
      <div class="col-6 reveal" style="--delay:120ms">
        <figure class="figure"><div class="frame aspect-4-5"><Image src={photos[0].src} alt={photos[0].alt[lang]} widths={[640, 1024, 1400]} sizes="(max-width: 900px) 100vw, 50vw" loading="eager" /></div></figure>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container prose reveal"><Content /></div>
  </section>

  <section class="section section--alt" aria-labelledby="steps-title">
    <div class="container">
      <h2 id="steps-title" class="visually-hidden">{page.data.eyebrow}</h2>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step reveal" style={`--delay:${(i % 2) * 80}ms`}>
            <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="step__body">
              <h3>{s.heading}</h3>
              <p>{s.text}</p>
              {s.note && <p class="small muted step__note">{s.note}</p>}
            </div>
            {i === 1 && <figure class="step__fig figure"><div class="frame aspect-1"><Image src={photos[1].src} alt={photos[1].alt[lang]} widths={[480, 800]} sizes="(max-width: 900px) 100vw, 30vw" loading="lazy" /></div></figure>}
            {i === 3 && <figure class="step__fig figure"><div class="frame aspect-1"><Image src={photos[2].src} alt={photos[2].alt[lang]} widths={[480, 800]} sizes="(max-width: 900px) 100vw, 30vw" loading="lazy" /></div></figure>}
            {i === 5 && <figure class="step__fig figure"><div class="frame aspect-1"><Image src={photos[3].src} alt={photos[3].alt[lang]} widths={[480, 800]} sizes="(max-width: 900px) 100vw, 30vw" loading="lazy" /></div></figure>}
            {i === 6 && <figure class="step__fig figure"><div class="frame aspect-1"><Image src={photos[4].src} alt={photos[4].alt[lang]} widths={[480, 800]} sizes="(max-width: 900px) 100vw, 30vw" loading="lazy" /></div></figure>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="doc-title">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">{lang === 'es' ? 'Documentación' : 'Documentation'}</p><h2 id="doc-title">{lang === 'es' ? 'Manos, herramientas, pigmentos' : 'Hands, tools, pigments'}</h2></div></div>
      <div class="doc-grid">
        <Placeholder lang={lang} ratio="4/5" title={lang === 'es' ? 'Manos en el modelado' : 'Hands at work'} text={lang === 'es' ? 'Fotografía documental por realizar en el taller de Felipe Linares Vargas.' : 'Documentary photograph to be made in Felipe Linares Vargas’s workshop.'} />
        <Placeholder lang={lang} ratio="4/5" title={lang === 'es' ? 'Herramientas y engrudo' : 'Tools and paste'} text={lang === 'es' ? 'Fotografía documental por realizar.' : 'Documentary photograph to be made.'} />
        <Placeholder lang={lang} ratio="4/5" title={lang === 'es' ? 'Video del proceso' : 'Process video'} text={lang === 'es' ? 'Video corto por incorporar con autorización del artista.' : 'Short video to be added with the artist’s permission.'} />
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container--narrow container text-center">
      <h2 class="reveal">{lang === 'es' ? 'Ver las piezas terminadas' : 'See the finished pieces'}</h2>
      <a class="btn mt-l reveal" style="--delay:100ms;color:var(--ivory)" href={route('works', lang)}>{ui.cta.works} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  .ws-hero h1 { font-size: var(--step-5); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-xl); }
  .step { display: grid; grid-template-columns: 6ch minmax(0, 52ch) minmax(0, 1fr); gap: var(--space-m) var(--space-l); align-items: start; padding-top: var(--space-m); border-top: 1px solid var(--line-strong); }
  .step__num { font-family: var(--font-display); font-size: var(--step-3); line-height: 1; color: var(--accent); font-variation-settings: 'opsz' 96; }
  .step__body h3 { font-size: var(--step-2); margin-bottom: var(--space-s); }
  .step__note { margin-top: var(--space-s); border-left: 2px solid var(--ochre); padding-left: var(--space-s); }
  .step__fig { max-width: 340px; justify-self: end; }
  .doc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gutter); }
  @media (max-width: 900px) { .step { grid-template-columns: 5ch 1fr; } .step__fig { grid-column: 2; justify-self: start; max-width: 280px; } .doc-grid { grid-template-columns: 1fr; } }
</style>

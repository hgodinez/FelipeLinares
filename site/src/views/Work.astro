---
import { Image, getImage } from 'astro:assets';
import { getEntries } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Lightbox from '@/components/Lightbox.astro';
import SourceList from '@/components/SourceList.astro';
import { t } from '@/i18n/ui';
import { alternates, route, workPath, type Lang } from '@/i18n/routes';
import { coverOf, type Work } from '@/lib/content';

interface Props { lang: Lang; work: Work }
const { lang, work } = Astro.props;
const ui = t(lang);
const es = lang === 'es';
const d = work.data;
const title = d.title[lang];
const cover = coverOf(work);
const related = (await getEntries(d.related)).filter(Boolean);
const gallery = await Promise.all(d.images.map(async (img) => ({ ...img, full: (await getImage({ src: img.src, width: Math.min(2000, img.src.width), format: 'webp', quality: 82 })).src })));
const main = gallery.find((g) => g.kind !== 'workshop') ?? gallery[0];
const rest = gallery.filter((g) => g !== main);
const ogImg = cover ? await getImage({ src: cover.src, width: 1200, format: 'jpg' }) : undefined;
const desc = d.description[lang].slice(0, 160).replace(/\s+\S*$/, '…');
const captionOf = (img: (typeof gallery)[number]) => [img.caption?.[lang], img.kind === 'workshop' ? ui.works.workshopNote : null].filter(Boolean).join(' · ');
const ld = { '@context': 'https://schema.org', '@type': 'VisualArtwork', name: title, creator: { '@type': 'Person', name: 'Felipe Linares Vargas' }, artform: 'Cartonería', artMedium: d.materials[lang], description: d.description[lang], ...(d.year ? { dateCreated: String(d.year) } : {}), ...(d.dimensions ? { size: d.dimensions } : {}), ...(ogImg ? { image: new URL(ogImg.src, Astro.site).toString() } : {}), url: new URL(workPath(work.id, lang), Astro.site).toString() };
const breadcrumb = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [ { '@type': 'ListItem', position: 1, name: ui.nav.home, item: new URL(route('home', lang), Astro.site).toString() }, { '@type': 'ListItem', position: 2, name: ui.nav.works, item: new URL(route('works', lang), Astro.site).toString() }, { '@type': 'ListItem', position: 3, name: title } ] };
const contactHref = `${route('contact', lang)}?obra=${encodeURIComponent(work.id)}`;
---
<Base lang={lang} title={title} description={desc} alternates={alternates('works', work.id)} ogImage={ogImg?.src} jsonLd={[ld, breadcrumb]} bodyClass="pagina-oscura">
  <article class="obra">
    <div class="contenedor">
      <nav class="miga" aria-label="Breadcrumb"><a href={route('works', lang)} data-back-link>← {ui.nav.works}</a></nav>
      <div class="obra-grid" data-lb-group>
        <div class="obra-fotos">
          <figure class="foto obra-principal">
            {main ? (
              <button type="button" class="obra-zoom" data-lb-open data-full={main.full} data-alt={main.alt[lang]} data-title={title} data-caption={captionOf(main)} aria-label={`${ui.works.open}: ${main.alt[lang]}`}>
                <Image src={main.src} alt={main.alt[lang]} widths={[640, 1024, 1600]} sizes="(max-width: 900px) 100vw, 44rem" loading="eager" fetchpriority="high" transition:name={`work-${work.id}`} />
              </button>
            ) : (
              <div class="marcador" style="aspect-ratio:4/5"><strong>{ui.works.placeholderTitle}</strong><span>{ui.works.placeholderText}</span></div>
            )}
            {main && <figcaption>{main.caption?.[lang] ?? `${title} · 1 ${ui.works.of} ${gallery.length}`}</figcaption>}
          </figure>
          {rest.length > 0 && (
            <ul class="obra-vistas">
              {rest.map((img, i) => (
                <li><figure class="foto">
                  <button type="button" class="obra-zoom" data-lb-open data-full={img.full} data-alt={img.alt[lang]} data-title={title} data-caption={captionOf(img)} aria-label={`${ui.works.open}: ${img.alt[lang]}`}>
                    <Image src={img.src} alt={img.alt[lang]} widths={[360, 600, 900]} sizes="(max-width: 900px) 45vw, 20rem" loading="lazy" />
                  </button>
                  <figcaption>{img.caption?.[lang] ?? (img.kind === 'workshop' ? ui.works.workshopNote : `${i + 2} ${ui.works.of} ${gallery.length}`)}</figcaption>
                </figure></li>
              ))}
            </ul>
          )}
        </div>
        <div class="obra-texto">
          <p class="antetitulo">{d.categories.map((c) => ui.works.categories[c]).join(' · ')}</p>
          <h1>{title}</h1>
          {d.titleStatus === 'provisional' && <p><span class="aviso">{ui.works.provisional}</span></p>}
          <p class="texto-suave" style="font-size:1.15rem">{d.description[lang]}</p>
          {d.context?.[lang] && <><h3 class="subtitulo-seccion" style="margin-top:1.5rem;font-size:1.4rem">{ui.works.context}</h3><p class="texto-suave">{d.context[lang]}</p></>}
          <h3 class="subtitulo-seccion" style="margin-top:1.5rem;font-size:1.4rem">{ui.works.detailsHeading}</h3>
          <dl class="ficha">
            <dt>{ui.works.year}</dt><dd>{d.year ?? ui.works.yearUnknown}{d.yearNote?.[lang] && ` · ${d.yearNote[lang]}`}</dd>
            <dt>{ui.works.materials}</dt><dd>{d.materials[lang]}</dd>
            <dt>{ui.works.dimensions}</dt><dd>{d.dimensions ?? ui.works.dimensionsUnknown}</dd>
            {d.collection && <><dt>{ui.works.collection}</dt><dd>{d.collection}</dd></>}
            <dt>{ui.works.availability}</dt><dd>{ui.works.availabilityLabels[d.availability]}</dd>
          </dl>
          {d.provenance?.[lang] && <p class="texto-suave" style="margin-top:1rem"><strong>{ui.works.provenance}:</strong> {d.provenance[lang]}</p>}
          <div class="botones"><a class="boton boton-principal" href={contactHref}>{ui.cta.inquire}</a></div>
          <div style="margin-top:1.5rem"><SourceList lang={lang} sources={d.sources} heading={ui.works.sources} /></div>
        </div>
      </div>
    </div>

    {related.length > 0 && (
      <section class="sala" aria-labelledby="titulo-relacionadas">
        <div class="contenedor">
          <h2 id="titulo-relacionadas" style="font-size:clamp(1.6rem,3vw,2.2rem)">{ui.works.related}</h2>
          <ul class="piezas">
            {related.map((r) => { const c = coverOf(r); return (
              <li class="pieza">
                {c ? <a class="pieza-imagen" href={workPath(r.id, lang)}><Image src={c.src} alt={c.alt[lang]} widths={[360, 600]} sizes="(max-width: 560px) 45vw, 20rem" loading="lazy" /></a> : <a class="marcador" href={workPath(r.id, lang)} style="aspect-ratio:3/4"><strong>{r.data.title[lang]}</strong></a>}
                <p><span><strong><a href={workPath(r.id, lang)}>{r.data.title[lang]}</a></strong><span class="pieza-nota">{r.data.categories.map((x) => ui.works.categories[x]).join(' · ')}</span></span></p>
              </li>
            ); })}
          </ul>
        </div>
      </section>
    )}
  </article>
  <Lightbox lang={lang} />
</Base>

<script>
  import { rememberOrigin } from '@/lib/motion';
  function initWork() {
    const article = document.querySelector<HTMLElement>('.obra');
    if (!article || article.dataset.ready) return;
    article.dataset.ready = '1';
    let fromGallery = false; try { fromGallery = !!sessionStorage.getItem('flv:origin'); } catch {}
    document.querySelectorAll<HTMLAnchorElement>('[data-back-link]').forEach((a) => a.addEventListener('click', (e) => { if (fromGallery && history.length > 1) { e.preventDefault(); history.back(); } }));
    document.addEventListener('keydown', (e) => { if (e.key !== 'Escape' || document.querySelector('dialog[open]') || (e.target as HTMLElement).closest('input, textarea, select')) return; if (fromGallery && history.length > 1) history.back(); });
    document.querySelectorAll<HTMLAnchorElement>('a[href*="/obras/"], a[href*="/works/"]').forEach((a) => a.addEventListener('click', () => { const m = a.getAttribute('href')!.match(/\/(?:obras|works)\/([^/]+)\//); if (m) rememberOrigin(m[1]); }));
  }
  initWork();
  document.addEventListener('astro:page-load', initWork);
</script>

<style>
  .obra { padding: clamp(1.5rem, 4vw, 3rem) 0 clamp(2rem, 5vw, 4rem); }
  .miga { margin-bottom: 1.5rem; font-weight: 600; }
  .miga a { text-decoration: none; }
  .miga a:hover { text-decoration: underline; }
  .obra-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (max-width: 900px) { .obra-grid { grid-template-columns: 1fr; } }
  .obra h1 { font-size: clamp(2rem, 4.5vw, 3.2rem); margin-bottom: 0.4em; }
  .obra-zoom { display: block; width: 100%; padding: 0; border: 0; background: #221b16; border-radius: var(--radio); overflow: hidden; cursor: zoom-in; box-shadow: 0 0 0 1px rgba(255, 250, 240, 0.14), 0 10px 30px rgba(0, 0, 0, 0.45); }
  .obra-zoom :global(img) { width: 100%; height: auto; border-radius: 0; box-shadow: none; transition: transform 0.5s ease; }
  .obra-zoom:hover :global(img) { transform: scale(1.02); }
  .obra-vistas { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; align-items: start; }
  .obra-texto { position: sticky; top: 5.5rem; }
  @media (max-width: 900px) { .obra-texto { position: static; } }
</style>

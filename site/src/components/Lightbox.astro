---
import { t } from '@/i18n/ui';
import type { Lang } from '@/i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
---
<dialog class="visor" data-lightbox aria-label={ui.works.gallery}>
  <div class="visor-barra">
    <span class="visor-contador" data-lb-counter data-of={ui.works.of} aria-live="polite"></span>
    <div style="display:flex;gap:0.5rem">
      <button type="button" class="visor-zoom" data-lb-zoom aria-pressed="false">{lang === 'es' ? 'Acercar' : 'Zoom'}</button>
      <button type="button" class="visor-cerrar" data-lb-close>{ui.lightbox.close}</button>
    </div>
  </div>
  <div class="visor-imagen" data-lb-stage>
    <button type="button" class="visor-anterior" data-lb-prev aria-label={ui.lightbox.prev}>‹</button>
    <img data-lb-img alt="" draggable="false" />
    <button type="button" class="visor-siguiente" data-lb-next aria-label={ui.lightbox.next}>›</button>
  </div>
  <div class="visor-texto">
    <p class="visor-titulo" data-lb-title></p>
    <p class="visor-descripcion" data-lb-caption></p>
  </div>
</dialog>
<script>
  import { initLightbox } from '@/lib/lightbox';
  initLightbox();
  document.addEventListener('astro:page-load', initLightbox);
</script>

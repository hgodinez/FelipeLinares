---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { t } from '@/i18n/ui';
import { workPath, type Lang } from '@/i18n/routes';
import Placeholder from './Placeholder.astro';

interface Props {
  work: CollectionEntry<'artworks'>;
  lang: Lang;
  /** visual size variant for the editorial grid */
  size?: 'large' | 'medium' | 'small';
  index?: number;
  eager?: boolean;
}
const { work, lang, size = 'medium', index = 0, eager = false } = Astro.props;
const ui = t(lang);
const d = work.data;
const cover = d.images.find((i) => i.kind === 'final') ?? d.images[0];
const title = d.title[lang];
const cats = d.categories.map((c) => ui.works.categories[c]).join(' · ');
const widths = size === 'large' ? [480, 800, 1200, 1600] : [360, 560, 800, 1100];
const sizes = size === 'large' ? '(max-width: 900px) 100vw, 60vw' : size === 'small' ? '(max-width: 600px) 100vw, 30vw' : '(max-width: 900px) 100vw, 42vw';
---
<article class:list={['work-card', `work-card--${size}`, 'reveal']} style={`--delay:${(index % 4) * 70}ms`} data-categories={d.categories.join(' ')} data-title={title.toLowerCase()} data-year={d.year ?? ''}>
  <a class="work-card__link" href={workPath(work.id, lang)}>
    <div class="frame work-card__frame">
      {cover ? (
        <Image src={cover.src} alt="" widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} decoding="async" />
      ) : (
        <Placeholder lang={lang} ratio="4/5" />
      )}
    </div>
    <div class="work-card__meta">
      <h3 class="work-card__title">
        {title}
        {d.titleStatus === 'provisional' && <span class="work-card__flag" title={ui.works.provisional} aria-label={ui.works.provisional}>*</span>}
      </h3>
      <p class="work-card__sub small muted">
        <span>{cats}</span>
        {d.year && <span> · {d.year}</span>}
      </p>
    </div>
  </a>
</article>

<style>
  .work-card { display: block; }
  .work-card__link { display: grid; gap: var(--space-s); text-decoration: none; }
  .work-card__frame { aspect-ratio: 4 / 5; }
  .work-card--large .work-card__frame { aspect-ratio: 3 / 4; }
  .work-card__frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .work-card__title { font-size: var(--step-1); font-variation-settings: 'opsz' 48, 'SOFT' 30; }
  .work-card--large .work-card__title { font-size: var(--step-2); }
  .work-card__flag { color: var(--accent-ink); margin-left: 0.15em; }
  .work-card__sub { margin: 0.25rem 0 0; }
</style>

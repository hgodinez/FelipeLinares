---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { t } from '@/i18n/ui';
import { workPath, type Lang } from '@/i18n/routes';
import Placeholder from './Placeholder.astro';

/**
 * A single encounter with a work. The image keeps its own proportions (no square crops),
 * lifts as a unit on hover/focus (FLOTAR) and travels to the detail page through a shared
 * view transition (REVELAR). Reading order stays in the DOM regardless of visual size.
 */
interface Props {
  work: CollectionEntry<'artworks'>;
  lang: Lang;
  /** Which photograph to show (index into images). */
  imageIndex?: number;
  /** Visual sizing hint for widths/sizes. */
  size?: 'large' | 'medium' | 'small';
  eager?: boolean;
  /** Show the full photograph without cropping (object-fit: contain in a fixed box). */
  contain?: boolean;
  class?: string;
}
const { work, lang, imageIndex = 0, size = 'medium', eager = false, contain = false, class: cls = '' } = Astro.props;
const ui = t(lang);
const d = work.data;
const finals = d.images.filter((i) => i.kind !== 'workshop');
const img = finals[imageIndex] ?? finals[0] ?? d.images[0];
const title = d.title[lang];
const cats = d.categories.map((c) => ui.works.categories[c]).join(' · ');
const widths = size === 'large' ? [480, 800, 1200, 1600] : size === 'small' ? [360, 560, 800] : [420, 700, 1000, 1300];
const sizes = size === 'large' ? '(max-width: 900px) 100vw, 58vw' : size === 'small' ? '(max-width: 600px) 100vw, 30vw' : '(max-width: 900px) 100vw, 40vw';
const ratio = img ? `${img.src.width} / ${img.src.height}` : '4 / 5';
---
<article class:list={['work-card', `work-card--${size}`, cls]} data-categories={d.categories.join(' ')} data-title={title.toLowerCase()} data-year={d.year ?? ''}>
  <a class="work-card__link" href={workPath(work.id, lang)} data-work-link={work.id} aria-label={`${ui.cta.viewWork}: ${title}`}>
    <div class:list={['work-card__media', 'float', { 'work-card__media--contain': contain }]} style={`aspect-ratio:${contain ? '4 / 5' : ratio}`}>
      {img ? (
        <Image src={img.src} alt="" widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} decoding="async" transition:name={`work-${work.id}`} />
      ) : (
        <Placeholder lang={lang} ratio="4/5" />
      )}
    </div>
    <div class="work-card__meta">
      <h3 class="work-card__title">
        {title}{d.titleStatus === 'provisional' && <span class="work-card__flag" aria-hidden="true">*</span>}
      </h3>
      <p class="work-card__sub small muted">
        <span>{cats}</span>{d.year && <span> · {d.year}</span>}
        {d.titleStatus === 'provisional' && <span class="visually-hidden"> · {ui.works.provisional}</span>}
      </p>
      <span class="work-card__cta link-arrow" aria-hidden="true">{ui.cta.viewWork} <span class="arrow">↗</span></span>
    </div>
  </a>
</article>

<style>
  .work-card { display: block; }
  .work-card__link { display: grid; gap: var(--space-s); text-decoration: none; }
  .work-card__media { position: relative; width: 100%; overflow: hidden; background: transparent; filter: drop-shadow(0 14px 22px rgba(25, 27, 36, 0.18)); }
  .work-card__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .work-card__media--contain :global(img) { object-fit: contain; }
  .work-card__link:hover .work-card__media, .work-card__link:focus-visible .work-card__media { filter: drop-shadow(0 22px 30px rgba(25, 27, 36, 0.24)); }
  .work-card__title { font-size: var(--type-h4); font-variation-settings: 'opsz' 48, 'SOFT' 30; }
  .work-card--large .work-card__title { font-size: var(--type-h3); }
  .work-card__flag { color: var(--coral-ink); margin-left: 0.1em; }
  .scene-ink .work-card__flag, .scene-cobalt .work-card__flag { color: var(--color-coral); }
  .work-card__sub { margin: 0.25rem 0 0; }
  .work-card__cta { margin-top: 0.2rem; min-height: 32px; }
  .work-card__link:hover .work-card__cta { border-bottom-color: currentColor; }
  @media (prefers-reduced-motion: reduce) { .work-card__link:hover .work-card__media { outline: 3px solid var(--focus); outline-offset: 4px; } }
</style>

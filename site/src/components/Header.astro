---
import { t } from '@/i18n/ui';
import { route, otherLang, type Lang, type RouteKey } from '@/i18n/routes';
interface Props { lang: Lang; alternates: Record<Lang, string> }
const { lang, alternates } = Astro.props;
const ui = t(lang);
const other = otherLang(lang);
const items: RouteKey[] = ['artist', 'works', 'workshop', 'legacy', 'archive', 'contact'];
const current = Astro.url.pathname;
const isActive = (key: RouteKey) => current.startsWith(route(key, lang));
---
<header class="encabezado" data-header>
  <div class="contenedor">
    <a class="marca" href={route('home', lang)}>
      <svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="30" fill="#b9321c"/><path d="M14 36c6-14 30-14 36 0" fill="none" stroke="#e8a01a" stroke-width="4" stroke-linecap="round"/><path d="M20 22l-6-10M44 22l6-10" stroke="#17807f" stroke-width="4" stroke-linecap="round"/><ellipse cx="24" cy="31" rx="5" ry="3.6" fill="#fffaf0"/><ellipse cx="40" cy="31" rx="5" ry="3.6" fill="#fffaf0"/><circle cx="24" cy="31" r="2" fill="#1c1612"/><circle cx="40" cy="31" r="2" fill="#1c1612"/><path d="M26 44c4 3 8 3 12 0" fill="none" stroke="#1c1612" stroke-width="3" stroke-linecap="round"/><path d="M32 44v8" stroke="#e8a01a" stroke-width="4" stroke-linecap="round"/><circle cx="12" cy="40" r="2.2" fill="#e8a01a"/><circle cx="52" cy="40" r="2.2" fill="#e8a01a"/><circle cx="16" cy="48" r="2.2" fill="#fffaf0"/><circle cx="48" cy="48" r="2.2" fill="#fffaf0"/></svg>
      <span>Felipe Linares Vargas <small>{lang === 'es' ? 'Cartonero · Ciudad de México' : 'Cartonería artist · Mexico City'}</small></span>
    </a>
    <button class="menu-boton" type="button" aria-expanded="false" aria-controls="navegacion" data-nav-toggle>
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z"/></svg>
      {ui.nav.menu}
    </button>
    <nav class="navegacion" id="navegacion" aria-label={ui.nav.menu} data-nav>
      <ul>
        {items.map((key) => <li><a href={route(key, lang)} aria-current={isActive(key) ? 'page' : undefined}>{ui.nav[key]}</a></li>)}
        <li class="idioma"><a href={alternates[other]} hreflang={other} lang={other} aria-label={ui.lang.label}>{other.toUpperCase()}</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  function initNav() {
    const boton = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    if (!boton || !nav || nav.dataset.ready) return;
    nav.dataset.ready = '1';
    const cerrar = (foco: boolean) => { nav.classList.remove('abierta'); boton.setAttribute('aria-expanded', 'false'); if (foco) boton.focus(); };
    boton.addEventListener('click', () => { const abierto = nav.classList.toggle('abierta'); boton.setAttribute('aria-expanded', String(abierto)); });
    nav.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) cerrar(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && nav.classList.contains('abierta')) cerrar(true); });
  }
  initNav();
  document.addEventListener('astro:after-swap', initNav);
</script>

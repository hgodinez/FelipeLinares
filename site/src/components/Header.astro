---
import { t } from '@/i18n/ui';
import { route, otherLang, type Lang, type RouteKey } from '@/i18n/routes';

interface Props { lang: Lang; alternates: Record<Lang, string>; overlay?: boolean; scene?: 'paper' | 'ink' | 'lime' | 'cobalt' | 'coral' }
const { lang, alternates, overlay = false, scene = 'paper' } = Astro.props;
const ui = t(lang);
const other = otherLang(lang);
const items: RouteKey[] = ['works', 'artist', 'workshop', 'legacy', 'archive', 'contact'];
const current = Astro.url.pathname;
const isActive = (key: RouteKey) => current.startsWith(route(key, lang));
const darkTop = scene === 'ink' || scene === 'cobalt';
---

<header class:list={['site-header', { 'site-header--overlay': overlay, 'site-header--dark': darkTop }]} data-header>
  <div class="container site-header__inner">
    <a class="brand" href={route('home', lang)} aria-label={ui.siteName}>
      <span class="brand__name">Felipe Linares Vargas</span>
      <span class="brand__sub">{ui.tagline}</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span data-label-open>{ui.nav.menu}</span>
      <span data-label-close hidden>{ui.nav.close}</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label={ui.nav.menu} data-nav>
      <ul class="site-nav__list">
        {items.map((key) => (
          <li><a href={route(key, lang)} aria-current={isActive(key) ? 'page' : undefined}>{ui.nav[key]}</a></li>
        ))}
      </ul>
      <a class="lang-switch" href={alternates[other]} hreflang={other} lang={other} aria-label={ui.lang.label}>
        <span aria-hidden="true">{lang.toUpperCase()}</span><span class="lang-switch__sep" aria-hidden="true">/</span><span>{other.toUpperCase()}</span>
        <span class="visually-hidden">— {ui.lang.switch}</span>
      </a>
    </nav>
  </div>
</header>

<script>
  function initNav() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!toggle || !nav || !header || header.dataset.ready) return;
    header.dataset.ready = '1';
    const open = toggle.querySelector<HTMLElement>('[data-label-open]')!;
    const close = toggle.querySelector<HTMLElement>('[data-label-close]')!;
    const set = (on: boolean) => {
      toggle.setAttribute('aria-expanded', String(on));
      header.classList.toggle('is-open', on);
      document.body.classList.toggle('nav-open', on);
      open.hidden = on; close.hidden = !on;
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && header.classList.contains('is-open')) { set(false); toggle.focus(); } });
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
  initNav();
  document.addEventListener('astro:after-swap', initNav);
</script>

<style>
  /* The paper background lives on a pseudo-element so the header itself never becomes a
     containing block for the fixed mobile navigation (backdrop-filter would). */
  .site-header { position: sticky; top: 0; z-index: 50; color: var(--color-ink); transition: color 300ms; }
  .site-header::before { content: ''; position: absolute; inset: 0; z-index: -1; background: rgba(247, 247, 242, 0.9); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid transparent; opacity: 0; transition: opacity 300ms, border-color 300ms; }
  .site-header.is-scrolled::before, .site-header.is-open::before { opacity: 1; border-bottom-color: rgba(25, 27, 36, 0.12); }
  .site-header.is-scrolled, .site-header.is-open { color: var(--color-ink); }
  .site-header--dark { color: var(--color-paper); }
  .site-header--overlay { position: fixed; inset-inline: 0; }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-m); min-height: var(--nav-h); }
  .brand { text-decoration: none; display: grid; line-height: 1.1; }
  .brand__name { font-family: var(--font-display); font-weight: 650; font-size: 1.15rem; letter-spacing: -0.01em; font-variation-settings: 'opsz' 24, 'SOFT' 30; }
  .brand__sub { font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 700; opacity: 0.72; margin-top: 0.2rem; }

  .site-nav { display: flex; align-items: center; gap: var(--space-m); }
  .site-nav__list { list-style: none; margin: 0; padding: 0; display: flex; gap: clamp(0.9rem, 0.4rem + 1.2vw, 2rem); }
  .site-nav__list a { display: inline-flex; align-items: center; min-height: 44px; font-size: 0.86rem; font-weight: 700; text-decoration: none; position: relative; }
  .site-nav__list a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 9px; height: 2px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform var(--d-control) var(--ease-paper); }
  .site-nav__list a:hover::after, .site-nav__list a[aria-current='page']::after { transform: scaleX(1); }
  .lang-switch { display: inline-flex; align-items: center; gap: 0.35em; min-height: 44px; padding: 0 0.9em; border: 1.5px solid currentColor; border-radius: 999px; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.08em; text-decoration: none; }
  .lang-switch > span:nth-child(3) { opacity: 0.6; }
  .lang-switch__sep { opacity: 0.4; }
  .site-header :focus-visible { outline-color: currentColor; }

  .nav-toggle { display: none; align-items: center; gap: 0.6em; min-height: 44px; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .nav-toggle__bar { width: 22px; height: 2px; background: currentColor; position: relative; display: block; }
  .nav-toggle__bar::before, .nav-toggle__bar::after { content: ''; position: absolute; left: 0; width: 100%; height: 2px; background: currentColor; transition: transform var(--d-control) var(--ease-paper); }
  .nav-toggle__bar::before { top: -7px; } .nav-toggle__bar::after { top: 7px; }
  .is-open .nav-toggle__bar { background: transparent; }
  .is-open .nav-toggle__bar::before { transform: translateY(7px) rotate(45deg); }
  .is-open .nav-toggle__bar::after { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 960px) {
    .site-header { --nav-h: 60px; }
    .brand__name { font-size: 1.05rem; } .brand__sub { display: none; }
    .nav-toggle { display: inline-flex; }
    .site-nav {
      position: fixed; inset: var(--nav-h) 0 0 0; background: var(--color-ink); color: var(--color-paper);
      flex-direction: column; align-items: flex-start; justify-content: flex-start;
      padding: var(--space-l) var(--gutter); gap: var(--space-l);
      clip-path: inset(0 0 100% 0); visibility: hidden;
      transition: clip-path 320ms var(--ease-paper), visibility 0s linear 320ms; overflow-y: auto;
    }
    .is-open .site-nav { clip-path: inset(0); visibility: visible; transition-delay: 0s; }
    .site-nav__list { flex-direction: column; gap: 0.1rem; }
    .site-nav__list a { font-family: var(--font-display); font-weight: 600; font-size: var(--type-h3); min-height: 60px; font-variation-settings: 'opsz' 72, 'SOFT' 30; }
    .site-nav__list a::after { bottom: 12px; }
    .site-nav :focus-visible { outline-color: var(--color-lime); }
    .lang-switch { border-color: var(--color-lime); color: var(--color-lime); }
    :global(body.nav-open) { overflow: hidden; }
  }
  @media (prefers-reduced-motion: reduce) { .site-nav { transition: none; } }
</style>

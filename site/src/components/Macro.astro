---
/**
 * A photograph used as a full-bleed environment with a text zone. The scrim follows the
 * text side only, so the sculpture stays unobstructed where it matters.
 * `srcMobile` allows art direction: a different (portrait) photograph under 900px.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  srcMobile?: ImageMetadata;
  position?: string;
  positionMobile?: string;
  scrim?: 'bottom' | 'left' | 'top' | 'none';
  minHeight?: string;
  eager?: boolean;
  class?: string;
  id?: string;
  labelledby?: string;
}
const { src, alt, srcMobile, scrim = 'bottom', position = '50% 50%', positionMobile, minHeight = '100svh', eager = false, class: cls = '', id, labelledby } = Astro.props;
const widths = [640, 1024, 1600, 2200].filter((w) => w <= src.width);
const desk = await getImage({ src, widths, format: 'webp', quality: 80 });
const mob = srcMobile ? await getImage({ src: srcMobile, widths: [480, 760, 1000].filter((w) => w <= srcMobile.width), format: 'webp', quality: 80 }) : null;
const posMobile = positionMobile ?? position;
---
<section class:list={['macro', 'bleed', cls]} style={`min-height:${minHeight}`} id={id} aria-labelledby={labelledby}>
  <div class="macro__img zoom-in" style={`--pos:${position};--pos-m:${posMobile}`}>
    <picture>
      {mob && <source media="(max-width: 900px)" srcset={mob.srcSet.attribute} sizes="100vw" />}
      <img src={desk.src} srcset={desk.srcSet.attribute} sizes="100vw" width={src.width} height={src.height} alt={alt} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding={eager ? 'sync' : 'async'} />
    </picture>
  </div>
  {scrim !== 'none' && <div class:list={['macro__scrim', `macro__scrim--${scrim}`]} />}
  <div class="macro__content">
    <slot />
  </div>
</section>

<style>
  .macro__img picture { display: contents; }
  .macro__img img { object-position: var(--pos); }
  @media (max-width: 900px) { .macro__img img { object-position: var(--pos-m); } }
</style>

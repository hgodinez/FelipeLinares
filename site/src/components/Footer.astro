---
import { t } from '@/i18n/ui';
import { route, type Lang, type RouteKey } from '@/i18n/routes';
import PapelPicado from '@/components/PapelPicado.astro';
import site from '@/data/site.json';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const legal: RouteKey[] = ['privacy', 'credits', 'accessibility'];
const year = new Date().getFullYear();
---
<div class="franjas" aria-hidden="true"></div>
<footer class="pie">
  <div class="contenedor" style="display:block">
    <span class="pie-grande" aria-hidden="true">Felipe Linares Vargas</span>
  </div>
  <div class="contenedor">
    <div>
      <p><strong>Felipe Linares Vargas</strong></p>
      <p>{ui.tagline}</p>
      <ul>{legal.map((k) => <li><a href={route(k, lang)}>{ui.nav[k]}</a></li>)}</ul>
    </div>
    <div>
      <p>{site.workshopArea[lang]}</p>
      <p>{ui.footer.rights}</p>
      <p>© {year} Felipe Linares Vargas</p>
    </div>
  </div>
  <div class="contenedor pie-plutus">
    <a href="https://plutusiq-ai.com/" target="_blank" rel="noopener noreferrer" class="powered-by-plutus">
      <img src="https://www.plutusiq-ai.com/.netlify/images?url=_astro%2Fplutusiq-logo.BotU7ixD.png&w=36&h=36" alt="" width="18" height="18" loading="lazy" decoding="async" onerror="this.hidden=true" />
      <span>Powered by Plutus iQ AI</span>
    </a>
  </div>
  <PapelPicado n={14} clase="picado-pie" />
</footer>

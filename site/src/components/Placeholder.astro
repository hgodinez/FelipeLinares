---
import { t } from '@/i18n/ui';
import type { Lang } from '@/i18n/routes';
interface Props { lang: Lang; title?: string; text?: string; class?: string; ratio?: string }
const { lang, title, text, class: cls = '', ratio } = Astro.props;
const ui = t(lang);
---
<div class:list={['placeholder', cls]} role="img" aria-label={`${title ?? ui.works.placeholderTitle}. ${text ?? ui.works.placeholderText}`} style={ratio ? `aspect-ratio:${ratio}` : undefined}>
  <strong aria-hidden="true">{title ?? ui.works.placeholderTitle}</strong>
  <span aria-hidden="true">{text ?? ui.works.placeholderText}</span>
</div>
